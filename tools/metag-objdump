#!/bin/sh
# Wrapper for the metag binutils 2.30 objdump kept on the NAS (README next to it). The SMB mount does not allow executing files, so the first call copies the binary to a local cache.
SRC=/Volumes/martin/Projects/Archive/ipad-nixos/tools/metag-binutils-2.30/bin
CACHE=${METAG_CACHE:-$HOME/.cache/metag-binutils-2.30}
if [ ! -x "$CACHE/objdump" ]; then
    mkdir -p "$CACHE" && cp "$SRC"/* "$CACHE"/ && chmod +x "$CACHE"/* || { echo "metag-objdump: cannot copy from $SRC" >&2; exit 1; }
fi
exec "$CACHE/objdump" "$@"
