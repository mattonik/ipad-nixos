+/*
+ * S5L byte-wide PIO with bounded feeding, after Berkay Kösebay's validated S8000 sequence (OrchardLinux kernel/patches/drivers/spi/0006): both word
+ * counts are the full length, AUTO_TX stays off, the RX FIFO is drained on every pass (also for transmit-only transfers, whose bytes are dropped), and
+ * never more than one FIFO of words is in flight unread. The existing path leaves RXCNT 0 and never reads RX on transmit-only transfers, and sets
+ * AUTO_TX on full-duplex ones, which hangs after 32 bytes (research/2026-11-01-orchardlinux-org-review.md, run P1). Selected by s5l_bounded_pio.
+ */
+static bool s5l_bounded_pio = true;
+module_param(s5l_bounded_pio, bool, 0644);
+MODULE_PARM_DESC(s5l_bounded_pio, "S5L: bounded full-duplex PIO feed for 8-bit transfers (default on)");
+
+static bool s5l_bounded_autotx = true;
+module_param(s5l_bounded_autotx, bool, 0644);
+MODULE_PARM_DESC(s5l_bounded_autotx, "S5L bounded PIO: set CFG AUTO_TX (bit 0), which the stock driver needs for any receive; run S1 timed out on 2 bytes without it");
+
+static uint s5l_bounded_mode = APPLE_SPI_CFG_MODE_IRQ;
+module_param(s5l_bounded_mode, uint, 0644);
+MODULE_PARM_DESC(s5l_bounded_mode, "S5L bounded PIO: CFG mode field set after RUN (0 polled, 1 = PIO enable as in the S8000 sequence; IRQ enables stay off); default 1");
+
+static int apple_s5l_spi_transfer_bounded(struct spi_controller *ctlr, struct apple_spi *spi, struct spi_transfer *t)
+{
+	const u8 *tx = t->tx_buf;
+	u8 *rx = t->rx_buf;
+	unsigned int sent = 0, received = 0, iterations = 0;
+	u64 word_ns = spi_delay_to_ns(&t->word_delay, t);
+	u64 wire_us = (u64)t->len * (8 * 1000000ULL / t->speed_hz + word_ns / 1000 + 1);
+	unsigned long end = jiffies + usecs_to_jiffies(wire_us) + msecs_to_jiffies(APPLE_SPI_TIMEOUT_MS);
+	u32 status, tx_level, rx_level;
+	int ret = 0;
+
+	reg_write(spi, APPLE_SPI_CTRL, APPLE_SPI_CTRL_RX_RESET | APPLE_SPI_CTRL_TX_RESET);
+	reg_write(spi, APPLE_SPI_STATUS, reg_read(spi, APPLE_SPI_STATUS));
+	reg_mask(spi, APPLE_SPI_CFG, APPLE_S5L_SPI_CFG_AUTO_TX | APPLE_SPI_CFG_MODE | APPLE_S5L_SPI_CFG_IE_FLAGS,
+		 FIELD_PREP(APPLE_SPI_CFG_MODE, APPLE_SPI_CFG_MODE_POLLED) |
+		 (s5l_bounded_autotx ? APPLE_S5L_SPI_CFG_AUTO_TX : 0));
+	reg_write(spi, APPLE_SPI_TXCNT, t->len);
+	reg_write(spi, APPLE_SPI_RXCNT, t->len);
+	/* Prime the TX FIFO before the controller starts shifting, like the existing path. */
+	while (sent < t->len && sent < APPLE_SPI_FIFO_DEPTH) {
+		reg_write(spi, APPLE_SPI_TXDATA, tx ? tx[sent] : 0xff);
+		sent++;
+	}
+	reg_write(spi, APPLE_SPI_CTRL, APPLE_SPI_CTRL_RUN);
+	/* PIO mode last, after enable and the word counts (S8000 order); the interrupt enables stay off, the loop polls. */
+	reg_mask(spi, APPLE_SPI_CFG, APPLE_SPI_CFG_MODE, FIELD_PREP(APPLE_SPI_CFG_MODE, s5l_bounded_mode & 3));
+
+	while (received < t->len) {
+		status = reg_read(spi, APPLE_SPI_STATUS);
+		tx_level = FIELD_GET(APPLE_S5L_SPI_STATUS_TXFIFO, status);
+		rx_level = FIELD_GET(APPLE_S5L_SPI_STATUS_RXFIFO, status);
+		if (tx_level > APPLE_SPI_FIFO_DEPTH || rx_level > APPLE_SPI_FIFO_DEPTH || rx_level > sent - received) {
+			dev_err(&ctlr->dev, "bounded PIO: invalid FIFO state, tx %u rx %u of %u, status=0x%x\n",
+				sent, received, t->len, status);
+			ret = -EIO;
+			break;
+		}
+		reg_write(spi, APPLE_SPI_STATUS, status);
+
+		while (rx_level--) {
+			u8 value = reg_read(spi, APPLE_SPI_RXDATA);
+
+			if (rx)
+				rx[received] = value;
+			received++;
+		}
+		while (sent < t->len && tx_level < APPLE_SPI_FIFO_DEPTH && sent - received < APPLE_SPI_FIFO_DEPTH) {
+			reg_write(spi, APPLE_SPI_TXDATA, tx ? tx[sent] : 0xff);
+			sent++;
+			tx_level++;
+		}
+
+		if (time_after(jiffies, end)) {
+			dev_err(&ctlr->dev, "bounded PIO timed out: tx %u rx %u of %u, status=0x%x\n",
+				sent, received, t->len, status);
+			ret = -ETIMEDOUT;
+			break;
+		}
+		if (!(++iterations & 0xff))
+			cond_resched();
+		cpu_relax();
+	}
+
+	reg_mask(spi, APPLE_SPI_CFG, APPLE_S5L_SPI_CFG_AUTO_TX, 0);
+	reg_write(spi, APPLE_SPI_CTRL, 0);
+	reg_write(spi, APPLE_SPI_STATUS, reg_read(spi, APPLE_SPI_STATUS));
+	return ret;
+}
