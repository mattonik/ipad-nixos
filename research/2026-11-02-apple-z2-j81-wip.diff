+/*
+ * J81 bring-up switches (research/2026-11-01-orchardlinux-org-review.md, Martin's 2026-11-02-j81-touch-runtime-gap.md).
+ * sync_window N (1..3): with no DT display-sync states, put AP GPIO 55 (display sync) on PINMUX peripheral function N at Apple's point,
+ * after the 19 c1 wake and before the dummy transfer while reset is asserted; the saved pad word is restored at power-off.
+ * poll_ms N: after the boot, read the report queue under the driver lock every N ms whether or not ATN fired, to tell a silent queue
+ * (no scanning) from contact data the firmware never signals.
+ */
+static uint sync_window;
+module_param(sync_window, uint, 0644);
+MODULE_PARM_DESC(sync_window, "J81: route GPIO55 to PINMUX peripheral function N (1..3) between wake and dummy");
+static uint poll_ms;
+static bool poll_wake;
+module_param(poll_wake, bool, 0644);
+MODULE_PARM_DESC(poll_wake, "J81: send the N1 wake before every poll read");
+module_param(poll_ms, uint, 0644);
+MODULE_PARM_DESC(poll_ms, "J81: poll the report queue every N ms after boot (0 = off)");
+
+#define J81_GPIO_BASE		0x20e300000ULL
+#define J81_GPIO_DISPLAY_SYNC	55
+#define J81_PINMUX_MASK		0x260u
+
+static void __iomem *j81_gpio55;
+static u32 j81_gpio55_saved;
+static bool j81_sync_routed;
+
+static void apple_z2_j81_sync_route(struct apple_z2 *z2)
+{
+	u32 want;
+
+	if (!sync_window || sync_window > 3 || j81_sync_routed)
+		return;
+	if (!j81_gpio55)
+		j81_gpio55 = ioremap(J81_GPIO_BASE + J81_GPIO_DISPLAY_SYNC * 4, 4);
+	if (!j81_gpio55)
+		return;
+	j81_gpio55_saved = readl(j81_gpio55);
+	want = (j81_gpio55_saved & ~J81_PINMUX_MASK) | 0x200u | (sync_window << 5);
+	writel(want, j81_gpio55);
+	j81_sync_routed = true;
+	dev_info(&z2->spidev->dev, "j81 display sync: GPIO55 0x%08x -> 0x%08x (reads 0x%08x)\n",
+		 j81_gpio55_saved, want, readl(j81_gpio55));
+}
+
+static void apple_z2_j81_sync_restore(struct apple_z2 *z2)
+{
+	if (!j81_sync_routed)
+		return;
+	writel(j81_gpio55_saved, j81_gpio55);
+	j81_sync_routed = false;
+	dev_info(&z2->spidev->dev, "j81 display sync: GPIO55 restored 0x%08x (reads 0x%08x)\n",
+		 j81_gpio55_saved, readl(j81_gpio55));
+	iounmap(j81_gpio55);
+	j81_gpio55 = NULL;
+}
+
+static struct delayed_work j81_poll_work;
+static struct apple_z2 *j81_poll_z2;
+static unsigned int j81_poll_count, j81_poll_frames;
+
+static void apple_z2_j81_poll(struct work_struct *work)
+{
+	struct apple_z2 *z2 = j81_poll_z2;
+	int error;
+
+	if (!z2 || !poll_ms)
+		return;
+	mutex_lock(&z2->io_lock);
+	if (z2->booted && !z2->stopping) {
+		/* poll_wake: wake the firmware (ee) before each read, as the resync path does; idle reads return all zeros. */
+		if (poll_wake) {
+			z2->wake_valid = false;
+			error = apple_z2_n1_wake_locked(z2);
+			if (error)
+				dev_info(&z2->spidev->dev, "j81 poll wake: %d\n", error);
+		}
+		error = apple_z2_read_packet(z2);
+		j81_poll_count++;
+		if (!error && (z2->runtime_frame_valid || !z2->runtime_queue_empty)) {
+			j81_poll_frames++;
+			dev_info(&z2->spidev->dev, "j81 poll %u: frame valid=%d empty=%d len-reply %*ph\n",
+				 j81_poll_count, z2->runtime_frame_valid, z2->runtime_queue_empty, 16, z2->rx_buf);
+		} else if (error) {
+			dev_info(&z2->spidev->dev, "j81 poll %u: error %d\n", j81_poll_count, error);
+		}
+		if (!(j81_poll_count % 50))
+			dev_info(&z2->spidev->dev, "j81 poll: %u reads, %u non-empty\n", j81_poll_count, j81_poll_frames);
+	}
+	mutex_unlock(&z2->io_lock);
+	if (!z2->stopping)
+		schedule_delayed_work(&j81_poll_work, msecs_to_jiffies(poll_ms));
+}
