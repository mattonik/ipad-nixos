+/*
+ * J81 bring-up experiment: after discovery the J81 firmware (0x381) sends only report 0x50 and no contacts. j81_init writes the iPhone 6 (N61)
+ * report-enable sequence, bit 0: 9d {1,0,0,0,0,0,0,0}, bit 1: bf {9d 81 09 00}, bit 2: af {0}. Default 0 (Orchard's iPad 5 flow).
+ */
+static uint j81_init;
+module_param(j81_init, uint, 0644);
+MODULE_PARM_DESC(j81_init, "J81 experiment: N61 report writes after discovery (bit0 9d, bit1 bf, bit2 af)");
+
+static int apple_z2_j81_init_locked(struct apple_z2 *z2)
+{
+	static const u8 rep9d[] = { 1, 0, 0, 0, 0, 0, 0, 0 };
+	static const u8 repbf[] = { 0x9d, 0x81, 0x09, 0 };
+	static const u8 repaf[] = { 0 };
+	int error = 0;
+
+	if (j81_init & 1)
+		error = apple_z2_write_report_locked(z2, 0x9d, rep9d, sizeof(rep9d), "j81-9d");
+	if (!error && (j81_init & 2))
+		error = apple_z2_write_report_locked(z2, 0xbf, repbf, sizeof(repbf), "j81-bf");
+	if (!error && (j81_init & 4))
+		error = apple_z2_write_report_locked(z2, 0xaf, repaf, sizeof(repaf), "j81-af");
+	dev_info(&z2->spidev->dev, "j81_init 0x%x: %d\n", j81_init, error);
+	return error;
 }
 
