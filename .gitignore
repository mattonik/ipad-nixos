# Build outputs (regenerated by nix build)
result
result-*

# Compressed kernel and dtbpack (regenerated from build outputs)
boot/Image.lzma
boot/dtbpack
boot/Pongo-t7001-diagnostic.bin
boot/Pongo-t7001-historical.bin

# Extracted firmware (not redistributable, extract from own IPSW)
firmware/
*.ipsw

# Raw Apple Device Tree/FDT captures contain per-device identifiers
artifacts/adt/
artifacts/i2c/
artifacts/live/

# Nix / devenv
.devenv/
.direnv/

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Local credentials and virtual-machine state
keys/
*.qcow2
*.img
vzvm.json

# Third-party binary tools kept locally so they survive /tmp being cleared
# (bit us 2026-09-12: palera1n was in /tmp, lost on a Mac reboot). Not
# redistributed -- see boot/vendor/README.md (tracked despite the dir being
# otherwise ignored) for the source and version.
boot/vendor/*
!boot/vendor/README.md
.DS_Store
__pycache__/
