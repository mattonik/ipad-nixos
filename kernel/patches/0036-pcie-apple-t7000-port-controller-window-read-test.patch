+	dev_info(dev,
+		 "t7000-pcie enable-enum-perst-portread-test: %s port %d refclk_en=0x%08x perst_internal=0x%08x unknown_10c=0x%08x link_enable=0x%08x ltssm=0x%08x\n",
+		 label, port,
+		 readl(shared + T7000_PCIE_REFCLK_EN + off),
+		 readl(shared + T7000_PCIE_PERST_INTERNAL + off),
+		 readl(shared + T7000_PCIE_UNKNOWN_10C + off),
+		 readl(shared + T7000_PCIE_LINK_ENABLE + off),
