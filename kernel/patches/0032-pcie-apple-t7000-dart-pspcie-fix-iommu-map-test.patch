diff --git a/drivers/pci/controller/pcie-apple-t7000.c b/drivers/pci/controller/pcie-apple-t7000.c
--- a/drivers/pci/controller/pcie-apple-t7000.c
+++ b/drivers/pci/controller/pcie-apple-t7000.c
@@ -1,59 +1,44 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Compile-only groundwork for the Apple T7000-family PCIe host controller.
+ * Apple T7000-family PCIe -- PMGR-only probe test, DART power-domains
+ * fix variant with iommu-map restored.
  *
- * The real J81 ADT describes four ports, four port interrupts and twelve
- * register windows. Corellium's older H9P driver confirms the four-port
- * controller shape, but its register layout, SART and hard-coded PHY sequence
- * are not valid for T7000. The disabled device tree preserves J81's exact
- * resource ordering without naming the unresolved small-window roles. Keep
- * this driver inert until those roles, DART attachment and ADT-provided
- * tunables have been implemented.
+ * The PCIe driver here is byte-for-byte the same as `0019`'s (the
+ * PMGR-only test that hardware-verified clean, 2026-09-23) and every
+ * later DART test's: probe() maps nothing and calls no PCI, ECAM or DART
+ * code at all. This patch's only changes are to the device tree:
+ * `dart_apcie1` keeps `0031`'s real compatible strings and
+ * `power-domains = <&ps_pcie>` fix, and `pcie`'s `iommu-map` is restored
+ * (the one thing `0031` still omitted).
+ *
+ * `0031` (real apple-dart driver, `power-domains` fix, no `iommu-map`)
+ * hardware-verified clean: the real driver's own "DART ... initialized"
+ * success message, genuine register map/reset/IRQ registration. This test
+ * is the natural next step, matching this project's own precedent from
+ * `0025`/`0026`: restore `pcie`'s `iommu-map`, establishing the real
+ * PCIe-to-DART IOMMU consumer relationship
+ * (`of_iommu_configure()`, invoked automatically when `pcie` is created,
+ * before any driver `.probe()` runs) -- distinct from, and potentially
+ * exercising more than, the DART's own bare probe/reset/IRQ path that
+ * `0031` alone already proved safe. See
+ * `research/t7000-pcie-hardware-findings.md`'s "`0031` hardware result:
+ * clean" section for the full reasoning.
+ *
+ * No controller register writes, no PERST change, no PCI enumeration, no
+ * AUX/REF gate changes -- only the DART DT status/compatible/
+ * power-domains fix and this one restored property.
  */
 
-#include <linux/errno.h>
 #include <linux/module.h>
-#include <linux/of.h>
-#include <linux/of_address.h>
 #include <linux/platform_device.h>
 
-#define APPLE_T7000_PCIE_NUM_PORTS	4
-#define APPLE_T7000_PCIE_NUM_REGIONS	12
-
-static int apple_t7000_pcie_validate_firmware(struct platform_device *pdev)
+static int apple_t7000_pcie_probe(struct platform_device *pdev)
 {
-	struct device *dev = &pdev->dev;
-	int count;
-
-	count = of_address_count(dev->of_node);
-	if (count != APPLE_T7000_PCIE_NUM_REGIONS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d register windows, found %d\n",
-				     APPLE_T7000_PCIE_NUM_REGIONS, count);
-
-	count = platform_irq_count(pdev);
-	if (count < 0)
-		return count;
-	if (count != APPLE_T7000_PCIE_NUM_PORTS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d port interrupts, found %d\n",
-				     APPLE_T7000_PCIE_NUM_PORTS, count);
-
+	dev_info(&pdev->dev,
+		 "t7000-pcie pmgr-only-test: probe reached (no MMIO, no PCI core; DART power-domains fix with iommu-map enabled separately)\n");
 	return 0;
 }
 
-static int apple_t7000_pcie_probe(struct platform_device *pdev)
-{
-	int ret;
-
-	ret = apple_t7000_pcie_validate_firmware(pdev);
-	if (ret)
-		return ret;
-
-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
-}
-
 static const struct of_device_id apple_t7000_pcie_of_match[] = {
 	{ .compatible = "apple,t7000-pcie" },
 	{ }
@@ -69,5 +54,5 @@
 };
 module_platform_driver(apple_t7000_pcie_driver);
 
-MODULE_DESCRIPTION("Compile-only Apple T7000 PCIe host bridge groundwork");
+MODULE_DESCRIPTION("Apple T7000 PCIe PMGR-only probe test, DART power-domains fix variant with iommu-map restored (no MMIO, no PCI core)");
 MODULE_LICENSE("GPL");
diff --git a/arch/arm64/boot/dts/apple/t7001.dtsi b/arch/arm64/boot/dts/apple/t7001.dtsi
--- a/arch/arm64/boot/dts/apple/t7001.dtsi
+++ b/arch/arm64/boot/dts/apple/t7001.dtsi
@@ -342,10 +342,26 @@
 		dart_apcie1: iommu@602002000 {
+			/*
+			 * DART power-domains fix, real driver, iommu-map
+			 * restored (docs/plans/2026-09-13-j81-wifi-pcie.md,
+			 * research/t7000-pcie-hardware-findings.md): 0031
+			 * (real apple-dart driver + power-domains = <&ps_pcie>
+			 * on dart_apcie1 itself, no iommu-map) hardware-
+			 * verified clean -- the real driver's own "DART ...
+			 * initialized" success message, genuine register map/
+			 * reset/IRQ registration. This test restores pcie's
+			 * iommu-map, establishing the real PCIe-to-DART IOMMU
+			 * consumer relationship (of_iommu_configure(),
+			 * invoked automatically when pcie is created, before
+			 * any driver .probe() runs) -- 0026's original scope,
+			 * with the power-domains fix now carried over.
+			 */
 			compatible = "apple,t7000-dart", "apple,s5l8960x-dart";
 			reg = <0x6 0x02002000 0x0 0x00200000>;
 			#iommu-cells = <1>;
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 216 IRQ_TYPE_LEVEL_HIGH>;
-			status = "disabled";
+			power-domains = <&ps_pcie>;
+			status = "okay";
 		};
 
 		pcie: pcie@610000000 {
@@ -376,10 +392,16 @@
 				     <AIC_IRQ 218 IRQ_TYPE_LEVEL_HIGH>,
 				     <AIC_IRQ 221 IRQ_TYPE_LEVEL_HIGH>;
 
-			msi-controller;
-			msi-parent = <&pcie>;
-			msi-ranges = <&aic AIC_IRQ 224 IRQ_TYPE_EDGE_RISING 32>;
-
+			/*
+			 * DART power-domains fix test, iommu-map restored:
+			 * this driver's probe() still maps nothing and calls
+			 * no PCI/ECAM/DART code itself, so
+			 * msi-controller/msi-parent/msi-ranges stay omitted
+			 * (no MSI domain implemented) -- but iommu-map is
+			 * restored here, establishing the real IOMMU-consumer
+			 * relationship to dart_apcie1 that 0031 deliberately
+			 * left out.
+			 */
 			iommu-map = <0x100 &dart_apcie1 0 1>;
 			iommu-map-mask = <0xff00>;
 
@@ -392,6 +414,6 @@
 				  0x7 0xc0000000 0x0 0x40000000>;
 
 			power-domains = <&ps_pcie>;
-			status = "disabled";
+			status = "okay";
 		};
 
