diff --git a/drivers/iommu/apple-dart-t7000-recovery-test.c b/drivers/iommu/apple-dart-t7000-recovery-test.c
new file mode 100644
--- /dev/null
+++ b/drivers/iommu/apple-dart-t7000-recovery-test.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * J81 DART recovery-write evidence gate.
+ *
+ * `kernel/patches/0025-...` (dart_apcie1 enabled, stock `apple-dart`
+ * driver bound, no `iommu-map`) hung on real hardware, 2026-09-23. Offline
+ * Ghidra tracing of the exact 12B410 kernelcache found that
+ * `AppleS5L8960XDART`'s availability-transition state machine calls
+ * `_dartRecoverFromPowerdown()` as part of becoming available, which
+ * writes `DART+0x24` *before* restoring any other cached configuration or
+ * touching anything else. The stock Linux `apple-dart` driver instead
+ * begins `apple_dart_hw_reset()` with a *read* of `DART+0x00`, never
+ * performing this write. See
+ * research/t7000-pcie-hardware-findings.md's "Helper and recovery path
+ * resolved" section for the full trace (real addresses, cross-checked
+ * against two independent unstripped Apple references).
+ *
+ * This driver performs only that one recovered write -- nothing else.
+ * No reset sequence, no IRQ registration, no IOMMU domain setup, no
+ * further register access of any kind. It exists purely to test whether
+ * Apple's write-before-read ordering is the meaningful difference behind
+ * the `0025` hang; it is not, and is never meant to become, a real DART
+ * driver.
+ */
+
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+/*
+ * Real J81 ADT `dart-apcie1` "error-reflector" property (0x20ffff000),
+ * right-shifted 12 bits by Apple's own `_dartRecoverFromPowerdown()` --
+ * recovered via Ghidra from the pinned iPad5,3 12B410 kernelcache, not
+ * guessed. See the module comment above for the full citation.
+ */
+#define J81_DART_APCIE1_ERROR_REFLECTOR	0x0020ffffU
+#define DART_ERROR_REFLECTOR_REG		0x24
+
+static int apple_t7000_dart_recovery_test_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	void __iomem *base;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	dev_info(dev,
+		 "t7000-dart recovery-write-test: about to write error-reflector (offset 0x%x) = 0x%08x\n",
+		 DART_ERROR_REFLECTOR_REG, J81_DART_APCIE1_ERROR_REFLECTOR);
+	writel(J81_DART_APCIE1_ERROR_REFLECTOR, base + DART_ERROR_REFLECTOR_REG);
+	dev_info(dev, "t7000-dart recovery-write-test: write completed, aborting probe\n");
+
+	return -ENODEV;
+}
+
+static const struct of_device_id apple_t7000_dart_recovery_test_of_match[] = {
+	{ .compatible = "apple,t7000-dart-recovery-test" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apple_t7000_dart_recovery_test_of_match);
+
+static struct platform_driver apple_t7000_dart_recovery_test_driver = {
+	.probe = apple_t7000_dart_recovery_test_probe,
+	.driver = {
+		.name = "apple-t7000-dart-recovery-test",
+		.of_match_table = apple_t7000_dart_recovery_test_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(apple_t7000_dart_recovery_test_driver);
+
+MODULE_DESCRIPTION("J81 DART recovery-write evidence gate (test only, not a real DART driver)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/pci/controller/pcie-apple-t7000.c b/drivers/pci/controller/pcie-apple-t7000.c
