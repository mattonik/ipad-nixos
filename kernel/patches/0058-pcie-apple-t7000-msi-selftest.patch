diff --git a/drivers/pci/controller/pcie-apple-t7000-msi-selftest.c b/drivers/pci/controller/pcie-apple-t7000-msi-selftest.c
--- /dev/null
+++ b/drivers/pci/controller/pcie-apple-t7000-msi-selftest.c
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Apple T7000 PCIe (iPad Air 2) MSI allocation self-test. TEST KERNELS ONLY.
+ *
+ * Binds to the J81 BCM4350 (14e4:43a3), allocates exactly one MSI vector through the
+ * host controller's MSI domain, reads back what the core programmed into the endpoint's
+ * MSI capability (address, data, control) and the interrupt's parent chain, takes and
+ * releases the interrupt, frees the vector and declines the device (-ENODEV).
+ *
+ * It enables no bus mastering, writes no firmware, and does not touch the controller's
+ * registers: the only device writes are the MSI capability fields written by the PCI core.
+ * The endpoint is never made to raise an MSI, so no interrupt is expected to fire.
+ *
+ * Expected on J81 (design: research/2026-10-05-t7000-msi-domain-design.md section 9):
+ * address 0x00000000_bffff000, data in 8..15, control with the enable bit set.
+ */
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+
+#define T7000_MSI_SELFTEST_PREFIX	"t7000-msi-selftest: "
+#define T7000_MSI_AIC_BASE		224	/* msi-vector-offset, ADT */
+#define T7000_MSI_EXPECT_ADDR		0xbffff000UL
+#define T7000_MSI_SLOT_FIRST		8
+#define T7000_MSI_SLOT_LAST		15
+
+static atomic_t t7000_msi_fired = ATOMIC_INIT(0);
+
+static irqreturn_t t7000_msi_selftest_irq(int irq, void *data)
+{
+	atomic_inc(&t7000_msi_fired);
+	return IRQ_HANDLED;
+}
+
+/*
+ * Log the parent chain and return its depth. levels[] receives the hwirq of each level, leaf
+ * first: [0] the per-device PCI-MSI domain, [1] the controller's MSI domain (the slot number),
+ * [2] the AIC (the event number, 224 + slot). Numeric hwirqs are the contract; domain names are
+ * only logged.
+ */
+static int t7000_msi_selftest_chain(int virq, unsigned long levels[], int max)
+{
+	struct irq_data *d;
+	int n = 0;
+
+	for (d = irq_get_irq_data(virq); d; d = d->parent_data, n++) {
+		pr_info(T7000_MSI_SELFTEST_PREFIX "  chain[%d]: domain=%s hwirq=%lu\n", n,
+			d->domain && d->domain->name ? d->domain->name : "?", d->hwirq);
+		if (n < max)
+			levels[n] = d->hwirq;
+	}
+	return n;
+}
+
+static int t7000_msi_selftest_probe(struct pci_dev *pdev, const struct pci_device_id *id)
+{
+	struct device *dev = &pdev->dev;
+	u16 ctl = 0, data = 0;
+	u32 lo = 0, hi = 0;
+	unsigned long levels[4] = { };
+	int pos, nvec, virq, ret, depth;
+	bool ok, chain_ok, teardown_ok;
+
+	pos = pci_find_capability(pdev, PCI_CAP_ID_MSI);
+	if (!pos) {
+		dev_err(dev, T7000_MSI_SELFTEST_PREFIX "no MSI capability\n");
+		return -ENODEV;
+	}
+
+	nvec = pci_alloc_irq_vectors(pdev, 1, 1, PCI_IRQ_MSI);
+	if (nvec != 1) {
+		dev_err(dev, T7000_MSI_SELFTEST_PREFIX "FAIL: pci_alloc_irq_vectors(1,1,MSI) = %d\n", nvec);
+		return -ENODEV;
+	}
+
+	virq = pci_irq_vector(pdev, 0);
+	pci_read_config_word(pdev, pos + PCI_MSI_FLAGS, &ctl);
+	pci_read_config_dword(pdev, pos + PCI_MSI_ADDRESS_LO, &lo);
+	if (ctl & PCI_MSI_FLAGS_64BIT) {
+		pci_read_config_dword(pdev, pos + PCI_MSI_ADDRESS_HI, &hi);
+		pci_read_config_word(pdev, pos + PCI_MSI_DATA_64, &data);
+	} else {
+		pci_read_config_word(pdev, pos + PCI_MSI_DATA_32, &data);
+	}
+
+	dev_info(dev, T7000_MSI_SELFTEST_PREFIX "virq=%d cap@0x%x ctl=0x%04x addr=0x%08x_%08x data=%u\n",
+		 virq, pos, ctl, hi, lo, data);
+	depth = t7000_msi_selftest_chain(virq, levels, ARRAY_SIZE(levels));
+
+	/* Exercises the parent's set_type/unmask path; nothing is expected to fire. */
+	ret = request_irq(virq, t7000_msi_selftest_irq, 0, "t7000-msi-selftest", pdev);
+	if (ret)
+		dev_err(dev, T7000_MSI_SELFTEST_PREFIX "request_irq failed: %d\n", ret);
+	else
+		free_irq(virq, pdev);
+
+	/* PCI slot n must map to AIC event 224 + n (die 0: the event number is the low 16 bits). */
+	chain_ok = depth == 3 && levels[1] == data && (levels[2] & 0xffff) == T7000_MSI_AIC_BASE + data;
+	ok = !ret && chain_ok && (ctl & PCI_MSI_FLAGS_ENABLE) && !hi && lo == T7000_MSI_EXPECT_ADDR &&
+	     data >= T7000_MSI_SLOT_FIRST && data <= T7000_MSI_SLOT_LAST;
+	dev_info(dev, T7000_MSI_SELFTEST_PREFIX "%s (config+chain: depth=%d chain_ok=%d, fired=%d, expected AIC hwirq %u)\n",
+		 ok ? "PASS" : "FAIL", depth, chain_ok, atomic_read(&t7000_msi_fired), T7000_MSI_AIC_BASE + data);
+
+	pci_free_irq_vectors(pdev);
+	pci_read_config_word(pdev, pos + PCI_MSI_FLAGS, &ctl);
+	teardown_ok = !(ctl & PCI_MSI_FLAGS_ENABLE);
+	dev_info(dev, T7000_MSI_SELFTEST_PREFIX "teardown %s: ctl=0x%04x (MSI enable bit %s)\n",
+		 teardown_ok ? "PASS" : "FAIL", ctl, teardown_ok ? "clear" : "STILL SET");
+	return -ENODEV;
+}
+
+static const struct pci_device_id t7000_msi_selftest_ids[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_BROADCOM, 0x43a3) },
+	{ }
+};
+MODULE_DEVICE_TABLE(pci, t7000_msi_selftest_ids);
+
+static struct pci_driver t7000_msi_selftest_driver = {
+	.name		= "t7000-msi-selftest",
+	.id_table	= t7000_msi_selftest_ids,
+	.probe		= t7000_msi_selftest_probe,
+};
+module_pci_driver(t7000_msi_selftest_driver);
+
+MODULE_DESCRIPTION("Apple T7000 PCIe MSI allocation self-test (test kernels only)");
+MODULE_LICENSE("GPL");
