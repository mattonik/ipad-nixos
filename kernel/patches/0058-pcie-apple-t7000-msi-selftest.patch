@@ -72,6 +72,17 @@
 
 	  If unsure, say N.
 
+config PCIE_APPLE_T7000_MSI_SELFTEST
+	bool "Apple T7000 PCIe MSI allocation self-test (test kernels only)"
+	depends on PCIE_APPLE_T7000=y
+	help
+	  Binds to the J81 BCM4350 at boot, allocates and frees one MSI vector,
+	  logs the address/data programmed into the endpoint's MSI capability,
+	  and declines the device. It never makes the endpoint raise an MSI.
+	  Not for production kernels.
+
+	  If unsure, say N.
+
