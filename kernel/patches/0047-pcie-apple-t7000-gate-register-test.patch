+/*
+ * Stage 5H: the exact register delta from Apple's +0x6d0 controller
+ * hook (FUN_ffffff8002e6e3e4, decompiled 2026-09-26 -- see
+ * research/t7000-pcie-stage5-handoff.md's "Post-Stage-5F gate trace"
+ * section). Runs as part of enableGated()'s early gate-enable phase,
+ * strictly before the port-hardware enable sequence below: for port 1,
+ * clears bit 0 at shared offset 0x180 (REFCLK_EN) and sets bit 0 at
+ * 0x198 (LINK_ENABLE). Isolated from Stage 5G's AUX/REF gate attach --
+ * see the module comment above for why these two deltas are kept
+ * separate.
+ */
+static void t7000_pcie_apply_gate_register_delta(struct device *dev,
+						  void __iomem *shared, int port)
+{
+	u32 off = port * T7000_PCIE_PORT_STRIDE;
+	u32 v;
+
+	v = readl(shared + T7000_PCIE_REFCLK_EN + off);
+	writel(v & ~BIT(0), shared + T7000_PCIE_REFCLK_EN + off);
+	dev_info(dev,
+		 "t7000-pcie gate-register-test: port %d 0x%03x: 0x%08x -> 0x%08x (clear bit0)\n",
+		 port, T7000_PCIE_REFCLK_EN + off, v,
+		 readl(shared + T7000_PCIE_REFCLK_EN + off));
+
+	v = readl(shared + T7000_PCIE_LINK_ENABLE + off);
+	writel(v | BIT(0), shared + T7000_PCIE_LINK_ENABLE + off);
+	dev_info(dev,
+		 "t7000-pcie gate-register-test: port %d 0x%03x: 0x%08x -> 0x%08x (set bit0)\n",
+		 port, T7000_PCIE_LINK_ENABLE + off, v,
+		 readl(shared + T7000_PCIE_LINK_ENABLE + off));
+}
