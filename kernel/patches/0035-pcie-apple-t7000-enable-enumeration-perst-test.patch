+				     "failed to parse PERST# ports\n");
 
-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
+	return pci_host_common_init(pdev, bridge, &apple_t7000_pcie_ecam_ops);
 }
 
