 		return ret;
 
-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
+	t7000_pcie_log_port(dev, shared, T7000_PCIE_TEST_PORT, "before");
+
+	dev_info(dev, "t7000-pcie link-start-test: about to write the recovered enable sequence for port %d\n",
+		 T7000_PCIE_TEST_PORT);
+	t7000_pcie_enable_port_hardware(dev, shared, T7000_PCIE_TEST_PORT);
+	dev_info(dev, "t7000-pcie link-start-test: enable sequence write completed\n");
