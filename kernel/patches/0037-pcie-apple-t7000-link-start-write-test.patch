-static int apple_t7000_pcie_validate_firmware(struct platform_device *pdev)
+/*
+ * Shared root-complex register window (ADT reg index 9, 0x600000000,
+ * 0x2000 bytes): one 0x80-byte block per port. Offsets/bits/delays are
+ * recovered exactly, not guessed -- see the module comment above.
+ */
+#define T7000_PCIE_PORT_STRIDE			0x80
+#define T7000_PCIE_REFCLK_EN			0x100
+#define T7000_PCIE_PERST_INTERNAL		0x108
+#define T7000_PCIE_UNKNOWN_10C			0x10c
+#define T7000_PCIE_LINK_ENABLE			0x118
+#define T7000_PCIE_LTSSM_BASE			0x820
+#define T7000_PCIE_LTSSM_STRIDE		0x40
+
+#define T7000_PCIE_REFCLK_EN_MUXED_AUXCLK_AUTO_DIS	BIT(20)
+#define T7000_PCIE_PERST_INTERNAL_BIT8			BIT(8)
+
+#define T7000_PCIE_REG_SHARED			9
+
+/*
+ * Per-port controller window: ADT reg index 2*port+1. Port 1 (the
+ * confirmed populated port) is index 3, physical address 0x602004000 --
+ * see Stage 4a's header comment for the full derivation.
+ */
+#define T7000_PCIE_REG_PORT_CONTROLLER(port)	(2 * (port) + 1)
+#define T7000_PCIE_PORT_CONFIG			0x80
+#define T7000_PCIE_PORT_CONFIG_LINK_START	BIT(0)
+
+/* Board port 1 is J81's only populated port; this driver never touches
+ * ports 2-4.
+ */
+#define T7000_PCIE_TEST_PORT			1
+
+static void t7000_pcie_log_port(struct device *dev, void __iomem *shared,
+				 int port, const char *label)
 {
-	struct device *dev = &pdev->dev;
