+	},
+};
+
+static int apple_t7000_pcie_probe(struct platform_device *pdev)
+{
+	struct pci_host_bridge *bridge;
+	int ret;
+
+	dev_info(&pdev->dev, "t7000-pcie link-start-test: probe entry\n");
+
+	bridge = devm_pci_alloc_host_bridge(&pdev->dev, 0);
