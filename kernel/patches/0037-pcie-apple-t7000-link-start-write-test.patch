-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d register windows, found %d\n",
-				     APPLE_T7000_PCIE_NUM_REGIONS, count);
+	dev_info(dev,
+		 "t7000-pcie link-start-test: %s port %d refclk_en=0x%08x perst_internal=0x%08x unknown_10c=0x%08x link_enable=0x%08x ltssm=0x%08x\n",
+		 label, port,
+		 readl(shared + T7000_PCIE_REFCLK_EN + off),
+		 readl(shared + T7000_PCIE_PERST_INTERNAL + off),
+		 readl(shared + T7000_PCIE_UNKNOWN_10C + off),
+		 readl(shared + T7000_PCIE_LINK_ENABLE + off),
+		 readl(shared + ltssm_off));
+}
 
-	count = platform_irq_count(pdev);
-	if (count < 0)
-		return count;
-	if (count != APPLE_T7000_PCIE_NUM_PORTS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d port interrupts, found %d\n",
-				     APPLE_T7000_PCIE_NUM_PORTS, count);
+static void t7000_pcie_enable_port_hardware(struct device *dev,
+					     void __iomem *shared, int port)
+{
+	u32 off = port * T7000_PCIE_PORT_STRIDE;
+	u32 ltssm_off = T7000_PCIE_LTSSM_BASE + port * T7000_PCIE_LTSSM_STRIDE;
+	u32 v;
 
+	v = readl(shared + T7000_PCIE_LINK_ENABLE + off);
+	writel(v & ~BIT(0), shared + T7000_PCIE_LINK_ENABLE + off);
+
+	v = readl(shared + T7000_PCIE_PERST_INTERNAL + off);
+	writel(v | BIT(0), shared + T7000_PCIE_PERST_INTERNAL + off);
+
+	udelay(10);
+
+	v = readl(shared + T7000_PCIE_UNKNOWN_10C + off);
+	writel(v & ~BIT(0), shared + T7000_PCIE_UNKNOWN_10C + off);
+
+	v = readl(shared + T7000_PCIE_REFCLK_EN + off);
+	writel(v | BIT(0), shared + T7000_PCIE_REFCLK_EN + off);
+
+	v = readl(shared + T7000_PCIE_REFCLK_EN + off);
+	writel(v | T7000_PCIE_REFCLK_EN_MUXED_AUXCLK_AUTO_DIS,
+	       shared + T7000_PCIE_REFCLK_EN + off);
+
+	udelay(100); /* t-refclk-to-perst, confirmed 100us on J81 */
+
+	v = readl(shared + T7000_PCIE_LINK_ENABLE + off);
+	writel(v | BIT(0), shared + T7000_PCIE_LINK_ENABLE + off);
+
+	v = readl(shared + T7000_PCIE_PERST_INTERNAL + off);
+	writel(v & ~T7000_PCIE_PERST_INTERNAL_BIT8,
+	       shared + T7000_PCIE_PERST_INTERNAL + off);
+
+	writel(3, shared + ltssm_off);
+
+	/* enableGated's own repeat of the final _enablePortHardware write. */
+	writel(3, shared + ltssm_off);
+}
+
+static int apple_t7000_pcie_map_window(struct device *dev, int index,
+					void __iomem **out)
+{
+	struct resource res;
+	int ret;
+
+	ret = of_address_to_resource(dev->of_node, index, &res);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "missing register window %d\n", index);
+
+	*out = devm_ioremap_resource(dev, &res);
+	return PTR_ERR_OR_ZERO(*out);
+}
+
+static void t7000_pcie_deassert_perst(struct device *dev,
+				       struct pci_host_bridge *bridge)
+{
+	struct pci_host_port *port;
+	struct pci_host_perst *perst;
+	unsigned int count = 0;
+
+	list_for_each_entry(port, &bridge->ports, list) {
+		list_for_each_entry(perst, &port->perst, list) {
+			dev_info(dev, "t7000-pcie link-start-test: deasserting PERST#\n");
+			gpiod_direction_output(perst->desc, 0);
+			count++;
+		}
+	}
+
+	if (!count) {
+		dev_info(dev, "t7000-pcie link-start-test: no PERST# GPIO found, nothing to deassert\n");
+		return;
+	}
+
+	/*
+	 * PCIE_RESET_CONFIG_WAIT_MS: the same generic PCIe-spec settle
+	 * constant pci_host_common_link_train_delay() and pci-imx6.c use
+	 * after deasserting PERST#, before any config access. Not an
+	 * Apple-recovered value.
+	 */
+	msleep(PCIE_RESET_CONFIG_WAIT_MS);
+}
+
+static int t7000_pcie_start_link(struct device *dev, int port)
+{
+	void __iomem *ctrl;
+	int ret;
+	u32 v;
+
+	ret = apple_t7000_pcie_map_window(dev,
+					   T7000_PCIE_REG_PORT_CONTROLLER(port),
+					   &ctrl);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to map port %d controller window\n",
+				     port);
+
+	dev_info(dev,
+		 "t7000-pcie link-start-test: port %d controller window before: 0x00=0x%08x 0x80=0x%08x\n",
+		 port, readl(ctrl + 0x00), readl(ctrl + T7000_PCIE_PORT_CONFIG));
+
+	v = readl(ctrl + T7000_PCIE_PORT_CONFIG);
+	writel(v | T7000_PCIE_PORT_CONFIG_LINK_START,
+	       ctrl + T7000_PCIE_PORT_CONFIG);
+
+	dev_info(dev,
+		 "t7000-pcie link-start-test: port %d controller window after: 0x00=0x%08x 0x80=0x%08x\n",
+		 port, readl(ctrl + 0x00), readl(ctrl + T7000_PCIE_PORT_CONFIG));
+
 	return 0;
 }
 
