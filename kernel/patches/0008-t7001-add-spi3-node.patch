--- a/arch/arm64/boot/dts/apple/t7001.dtsi	2026-09-09 15:53:30
+++ b/arch/arm64/boot/dts/apple/t7001.dtsi	2026-09-09 15:53:56
@@ -194,6 +194,33 @@
 			status = "disabled";
 		};
 
+		/*
+		 * TOUCH-1 (docs/plans/2026-09-09-j81-touch-spi3.md): the touch
+		 * controller's SPI transport. Register base 0x20a08c000, IRQ
+		 * 155 and clock gate 0x4d confirmed against the real J81 ADT
+		 * capture, same decode method as serial3/serial5 above.
+		 * Compatible "apple,s5l8960x-spi" matches the real string
+		 * used in Hoolock's tests/kat-spi experiment (commit
+		 * c065201), which this board's driver support is ported
+		 * from -- see kernel/patches/0007-spi-apple-add-s5l8960x-support.patch.
+		 * No touch child node here yet -- this stage only proves the
+		 * controller itself registers and can do a bounded transfer.
+		 */
+		spi3: spi@20a08c000 {
+			compatible = "apple,s5l8960x-spi";
+			reg = <0x2 0x0a08c000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 155 IRQ_TYPE_LEVEL_HIGH>;
+			/* Use the bootloader-enabled clocks for now. */
+			clocks = <&clkref>;
+			power-domains = <&ps_spi3>;
+			pinctrl-0 = <&spi3_pins>;
+			pinctrl-names = "default";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 		i2c0: i2c@20a110000 {
 			compatible = "apple,t7000-i2c", "apple,i2c";
 			reg = <0x2 0x0a110000 0x0 0x1000>;
@@ -405,6 +432,24 @@
 			uart5_pins: uart5-pins {
 				pinmux = <APPLE_PINMUX(34, 2)>;
 			};
+
+			/*
+			 * AP GPIO 51, function 1 (SPI3 CS0): independently
+			 * decoded from the real J81 ADT's function-spi_cs0
+			 * OIPG descriptor on spi3, alt-function 1 -- NOT 2,
+			 * despite UART3/UART5's pins above both using 2.
+			 * Checked broadly before trusting this (every
+			 * function-tx/function-rts pair across every UART
+			 * instance in the ADT, not just UART3/UART5): the
+			 * flags word's low byte genuinely varies per pin
+			 * (mostly 2, but a real counter-example at 1), so
+			 * it's a real per-pin alt-function index, not a
+			 * constant -- see the plan doc's "Pinmux
+			 * alt-function: resolved, not assumed".
+			 */
+			spi3_pins: spi3-pins {
+				pinmux = <APPLE_PINMUX(51, 1)>;
+			};
 		};
 	};
 
