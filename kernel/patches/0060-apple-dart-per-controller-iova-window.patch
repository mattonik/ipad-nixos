+		struct apple_dart_iova_gap gaps[2];
+		u64 start, end, top;
+		int i, n;
+
+		if (cfg && apple_dart_pci_iova_window(dev, &start, &end)) {
+			top = BIT_ULL(cfg->stream_maps[0].dart->ias);
+			n = apple_dart_iova_window_gaps(start, end, doorbell, have_doorbell, top, gaps);
+			for (i = 0; i < n; i++) {
+				struct iommu_resv_region *region;
+
+				region = iommu_alloc_resv_region(gaps[i].start, gaps[i].len, 0,
+								 IOMMU_RESV_RESERVED, GFP_KERNEL);
+				if (!region)
+					return;
+
+				list_add_tail(&region->list, head);
+			}
+		}
