+/*
+ * The IOVA window of the PCIe host bridge above a PCI device, if its controller node declares
+ * one with `apple,iova-window` (two 64-bit values: start and end, end exclusive). The T7000 PCIe
+ * DART translates only [vm-offset, vm-offset + vm-size) in Apple's configuration (J81:
+ * [0x80000000, 0xbffff000), directly below the MSI doorbell page); everything else is left
+ * unreserved by the stock driver, whose allocator would hand out IOVAs near the top of its
+ * 32-bit space.
+ */
+static bool apple_dart_pci_iova_window(struct device *dev, u64 *start, u64 *end)
+{
+	struct pci_host_bridge *bridge = pci_find_host_bridge(to_pci_dev(dev)->bus);
+	struct device *parent = bridge ? bridge->dev.parent : NULL;
+
+	return parent && parent->of_node &&
+	       !of_property_read_u64_index(parent->of_node, "apple,iova-window", 0, start) &&
+	       !of_property_read_u64_index(parent->of_node, "apple,iova-window", 1, end);
+}
+
+struct apple_dart_iova_gap {
+	u64 start;
+	u64 len;
+};
+
+/*
+ * Ranges of [0, top) outside the window [start, end). When the doorbell page sits at `end` it
+ * already has its own IOMMU_RESV_MSI region, so the upper gap begins above it. Returns the
+ * number of gaps (0 to 2); an invalid window (empty, or beyond `top`) yields none.
+ */
+static int apple_dart_iova_window_gaps(u64 start, u64 end, u64 doorbell, bool have_doorbell,
+				       u64 top, struct apple_dart_iova_gap gaps[2])
+{
+	u64 high = end;
+	int n = 0;
+
+	if (start >= end || end > top)
+		return 0;
+	if (have_doorbell && (doorbell & PAGE_MASK) == end)
+		high += PAGE_SIZE;
+	if (start)
+		gaps[n++] = (struct apple_dart_iova_gap){ 0, start };
+	if (high < top)
+		gaps[n++] = (struct apple_dart_iova_gap){ high, top - high };
+	return n;
+}
+
 static void apple_dart_get_resv_regions(struct device *dev,
 					struct list_head *head)
 {
