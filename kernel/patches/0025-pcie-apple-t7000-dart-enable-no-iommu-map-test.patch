--- a/drivers/pci/controller/pcie-apple-t7000.c
+++ b/drivers/pci/controller/pcie-apple-t7000.c
@@ -1,59 +1,44 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Compile-only groundwork for the Apple T7000-family PCIe host controller.
+ * Apple T7000-family PCIe -- PMGR-only probe test, DART-enable variant.
  *
- * The real J81 ADT describes four ports, four port interrupts and twelve
- * register windows. Corellium's older H9P driver confirms the four-port
- * controller shape, but its register layout, SART and hard-coded PHY sequence
- * are not valid for T7000. The disabled device tree preserves J81's exact
- * resource ordering without naming the unresolved small-window roles. Keep
- * this driver inert until those roles, DART attachment and ADT-provided
- * tunables have been implemented.
+ * The PCIe driver here is byte-for-byte the same as `0019`'s (the
+ * PMGR-only test that hardware-verified clean, 2026-09-23): probe() maps
+ * nothing and calls no PCI, ECAM or DART code at all. The only thing this
+ * patch changes is the device tree -- `dart_apcie1` also flips to
+ * `status = "okay"`, letting the stock Linux `apple-dart` driver
+ * (`drivers/iommu/apple-dart.c`, `apple,s5l8960x-dart` match) probe for
+ * real: map its own register window, check its IRQ, and reset the unit.
+ * `pcie`'s `iommu-map` stays omitted here -- this test is DART's own
+ * probe/reset/IRQ path in isolation, with no IOMMU consumer relationship
+ * to it at all. A follow-up test (patch 0026) repeats this with
+ * `iommu-map` restored, only if this one is clean.
+ *
+ * Six clean hardware tests (`0019`-`0024`) already proved every piece of
+ * the PCIe side safe; both hanging `0018` attempts had DART enabled with a
+ * live `iommu-map`, making DART/IOMMU activation the sole remaining
+ * common difference. See docs/plans/2026-09-13-j81-wifi-pcie.md and
+ * research/t7000-pcie-hardware-findings.md for the full reasoning,
+ * including the offline Ghidra recovery of Apple's own
+ * `function-dart_force_active` call order (not replicated here -- Linux's
+ * DART driver has no equivalent on-demand-availability model, so this
+ * test characterizes the stock Linux reset path on its own terms, not a
+ * replay of Apple's platform function).
+ *
+ * No controller register writes, no PERST change, no PCI enumeration, no
+ * AUX/REF gate changes -- only the DART DT status flip.
  */

-#include <linux/errno.h>
 #include <linux/module.h>
-#include <linux/of.h>
-#include <linux/of_address.h>
 #include <linux/platform_device.h>

-#define APPLE_T7000_PCIE_NUM_PORTS	4
-#define APPLE_T7000_PCIE_NUM_REGIONS	12
-
-static int apple_t7000_pcie_validate_firmware(struct platform_device *pdev)
+static int apple_t7000_pcie_probe(struct platform_device *pdev)
 {
-	struct device *dev = &pdev->dev;
-	int count;
-
-	count = of_address_count(dev->of_node);
-	if (count != APPLE_T7000_PCIE_NUM_REGIONS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d register windows, found %d\n",
-				     APPLE_T7000_PCIE_NUM_REGIONS, count);
-
-	count = platform_irq_count(pdev);
-	if (count < 0)
-		return count;
-	if (count != APPLE_T7000_PCIE_NUM_PORTS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d port interrupts, found %d\n",
-				     APPLE_T7000_PCIE_NUM_PORTS, count);
-
+	dev_info(&pdev->dev,
+		 "t7000-pcie pmgr-only-test: probe reached (no MMIO, no PCI core; DART enabled separately)\n");
 	return 0;
 }

-static int apple_t7000_pcie_probe(struct platform_device *pdev)
-{
-	int ret;
-
-	ret = apple_t7000_pcie_validate_firmware(pdev);
-	if (ret)
-		return ret;
-
-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
-}
-
 static const struct of_device_id apple_t7000_pcie_of_match[] = {
 	{ .compatible = "apple,t7000-pcie" },
 	{ }
@@ -69,5 +54,5 @@
 };
 module_platform_driver(apple_t7000_pcie_driver);

-MODULE_DESCRIPTION("Compile-only Apple T7000 PCIe host bridge groundwork");
+MODULE_DESCRIPTION("Apple T7000 PCIe PMGR-only probe test, DART-enable variant (no MMIO, no PCI core, no iommu-map)");
 MODULE_LICENSE("GPL");
--- a/arch/arm64/boot/dts/apple/t7001.dtsi
+++ b/arch/arm64/boot/dts/apple/t7001.dtsi
@@ -345,7 +345,7 @@
 			#iommu-cells = <1>;
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 216 IRQ_TYPE_LEVEL_HIGH>;
-			status = "disabled";
+			status = "okay";
 		};

 		pcie: pcie@610000000 {
@@ -376,13 +376,19 @@
 				     <AIC_IRQ 218 IRQ_TYPE_LEVEL_HIGH>,
 				     <AIC_IRQ 221 IRQ_TYPE_LEVEL_HIGH>;

-			msi-controller;
-			msi-parent = <&pcie>;
-			msi-ranges = <&aic AIC_IRQ 224 IRQ_TYPE_EDGE_RISING 32>;
+			/*
+			 * DART-enable test, no iommu-map
+			 * (docs/plans/2026-09-13-j81-wifi-pcie.md): DART's own
+			 * probe/reset/IRQ path in isolation. This driver's
+			 * probe() maps nothing and calls no PCI/ECAM/DART code
+			 * itself, so msi-controller/msi-parent/msi-ranges are
+			 * still omitted (no MSI domain implemented) and
+			 * iommu-map/iommu-map-mask stay omitted deliberately --
+			 * this test is DART alone, with no IOMMU consumer
+			 * relationship declared. A follow-up test restores
+			 * iommu-map, only if this one is clean.
+			 */

-			iommu-map = <0x100 &dart_apcie1 0 1>;
-			iommu-map-mask = <0xff00>;
-
 			bus-range = <0 4>;
 			#address-cells = <3>;
 			#size-cells = <2>;
@@ -392,6 +398,6 @@
 				  0x7 0xc0000000 0x0 0x40000000>;

 			power-domains = <&ps_pcie>;
-			status = "disabled";
+			status = "okay";
 		};

