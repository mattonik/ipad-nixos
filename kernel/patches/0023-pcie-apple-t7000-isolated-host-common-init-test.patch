+			/*
+			 * Isolated pci_host_common_init() test
+			 * (docs/plans/2026-09-13-j81-wifi-pcie.md's
+			 * "Multi-offset ECAM read test: hardware-verified
+			 * clean" section): no MSI domain, no IOMMU. This
+			 * driver's probe() calls pci_host_common_init() with a
+			 * bare ECAM ops struct and nothing else, so
+			 * msi-controller/msi-parent/msi-ranges and
+			 * iommu-map/iommu-map-mask are deliberately omitted --
+			 * this driver implements no MSI domain, and iommu-map
+			 * would pull in an of_iommu_configure() lookup against
+			 * dart_apcie1 this test needs to avoid to keep DART
+			 * fully out of the picture. No reset-gpios child node
+			 * either -- pci_host_common_init() never calls the
+			 * PERST-deassert helper on its own (see 0018's file
+			 * comment for the real source verification), so this
+			 * test's isolation doesn't need one.
+			 */

-			iommu-map = <0x100 &dart_apcie1 0 1>;
-			iommu-map-mask = <0xff00>;
-
