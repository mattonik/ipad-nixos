 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Compile-only groundwork for the Apple T7000-family PCIe host controller.
+ * Apple T7000-family PCIe -- multi-offset bounded ECAM read test.
  *
- * The real J81 ADT describes four ports, four port interrupts and twelve
- * register windows. Corellium's older H9P driver confirms the four-port
- * controller shape, but its register layout, SART and hard-coded PHY sequence
- * are not valid for T7000. The disabled device tree preserves J81's exact
- * resource ordering without naming the unresolved small-window roles. Keep
- * this driver inert until those roles, DART attachment and ADT-provided
- * tunables have been implemented.
+ * Three clean hardware results in a row (`0019`, `0020`, `0021`) rule out
+ * the DT `status = "okay"` flip, the power-domain attachment, the
+ * shared-window MMIO access, and a single ECAM read at bus0/dev0/fn0
+ * (offset 0) as causes of the original hang. Both hanging `0018` attempts
+ * called `pci_host_probe()`, the generic PCI bus scan, which this test
+ * still never does.
+ *
+ * Leading hypothesis: `bus-range = <0 4>` means a full scan walks far more
+ * of the declared 16 MiB ECAM window than a single offset-0 read does. If
+ * only part of that window is genuinely mapped, safe silicon, a full scan
+ * would reach the unsafe part while offset 0 did not. This test reads
+ * three more points using the standard ECAM addressing the kernel's own
+ * `pci_ecam_map_bus()` computes (`(bus << 20) | (device << 15) |
+ * (function << 12)`, the default `bus_shift = 20` this driver's
+ * `pci_ecam_ops` never overrides):
+ *
+ *   - bus 0, device 0, function 0 (offset 0): the same slot `0021` already
+ *     read cleanly (0xffffffff) -- repeated here as an in-run sanity
+ *     anchor, not new evidence on its own.
+ *   - bus 1, device 0, function 0 (offset 0x100000): the real J81 ADT's
+ *     `apcie` node declares `bus-range = <0 4>` for four physical ports;
+ *     the most standard mapping for this shape of multi-port ECAM root
+ *     complex is one bus number per downstream port, with bus 0 as the
+ *     root/virtual bus (consistent with the all-Fs, "no real device"
+ *     result already seen there). If so, bus 1 is board port 1 -- the
+ *     only populated port, wired to BCM4350 -- making this the most
+ *     likely candidate for a genuinely different (and possibly unsafe)
+ *     register range than bus 0.
+ *   - bus 4, device 0, function 0 (offset 0x400000): the far edge of the
+ *     declared `bus-range`, as a boundary check.
+ *
+ * Each read is independently bounded and logged via dev_info() before the
+ * next one runs, so if this hangs, dmesg (once retrieved, or on a future
+ * boot with earlier console output) pinpoints exactly which offset it
+ * happened at -- unlike the original write-capable driver or a full
+ * pci_host_probe() bus scan, neither of which isolate individual steps.
+ * Still no pci_ecam_create(), no pci_ops, no generic bus-scan code, no
+ * DART.
  */

-#include <linux/errno.h>
+#include <linux/io.h>
 #include <linux/module.h>
-#include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/platform_device.h>

-#define APPLE_T7000_PCIE_NUM_PORTS	4
-#define APPLE_T7000_PCIE_NUM_REGIONS	12
+#define T7000_PCIE_REG_ECAM		0

-static int apple_t7000_pcie_validate_firmware(struct platform_device *pdev)
+#define ECAM_BUS_SHIFT			20
+#define ECAM_OFFSET(bus)		((u32)(bus) << ECAM_BUS_SHIFT)
+
+static void t7000_pcie_read_slot(struct device *dev, void __iomem *ecam,
+				  unsigned int bus)
 {
-	struct device *dev = &pdev->dev;
-	int count;
+	u32 val;

-	count = of_address_count(dev->of_node);
-	if (count != APPLE_T7000_PCIE_NUM_REGIONS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d register windows, found %d\n",
-				     APPLE_T7000_PCIE_NUM_REGIONS, count);
+	dev_info(dev, "t7000-pcie ecam-multi-test: about to read bus %u dev0 fn0 (offset 0x%x)\n",
+		 bus, ECAM_OFFSET(bus));

-	count = platform_irq_count(pdev);
-	if (count < 0)
-		return count;
-	if (count != APPLE_T7000_PCIE_NUM_PORTS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d port interrupts, found %d\n",
-				     APPLE_T7000_PCIE_NUM_PORTS, count);
+	val = readl(ecam + ECAM_OFFSET(bus));

-	return 0;
+	dev_info(dev, "t7000-pcie ecam-multi-test: bus %u dev0 fn0 vendor/device=0x%08x\n",
+		 bus, val);
 }

 static int apple_t7000_pcie_probe(struct platform_device *pdev)
 {
+	struct device *dev = &pdev->dev;
+	struct resource res;
+	void __iomem *ecam;
 	int ret;

-	ret = apple_t7000_pcie_validate_firmware(pdev);
+	dev_info(dev, "t7000-pcie ecam-multi-test: probe entry\n");
+
+	ret = of_address_to_resource(dev->of_node, T7000_PCIE_REG_ECAM, &res);
 	if (ret)
-		return ret;
+		return dev_err_probe(dev, ret, "missing register window %d\n",
+				      T7000_PCIE_REG_ECAM);

-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
+	dev_info(dev, "t7000-pcie ecam-multi-test: window %d at %pR\n",
+		 T7000_PCIE_REG_ECAM, &res);
+
+	ecam = devm_ioremap_resource(dev, &res);
+	if (IS_ERR(ecam))
+		return PTR_ERR(ecam);
+
+	dev_info(dev, "t7000-pcie ecam-multi-test: mapped, starting bounded reads\n");
+
+	t7000_pcie_read_slot(dev, ecam, 0);
+	t7000_pcie_read_slot(dev, ecam, 1);
+	t7000_pcie_read_slot(dev, ecam, 4);
+
+	dev_info(dev, "t7000-pcie ecam-multi-test: all reads completed\n");
+
+	return 0;
 }

 static const struct of_device_id apple_t7000_pcie_of_match[] = {
@@ -69,5 +113,5 @@
 };
 module_platform_driver(apple_t7000_pcie_driver);

-MODULE_DESCRIPTION("Compile-only Apple T7000 PCIe host bridge groundwork");
+MODULE_DESCRIPTION("Apple T7000 PCIe multi-offset bounded ECAM read test (no pci_ecam_create, no bus scan, no DART)");
 MODULE_LICENSE("GPL");
