+#define T7000_PCIE_PORT_STRIDE		0x80
+#define T7000_PCIE_REFCLK_EN		0x100
+#define T7000_PCIE_PERST_INTERNAL	0x108
+#define T7000_PCIE_UNKNOWN_10C		0x10c
+#define T7000_PCIE_LINK_ENABLE		0x118
+#define T7000_PCIE_LTSSM_BASE		0x820
+#define T7000_PCIE_LTSSM_STRIDE	0x40
