+static void apple_t7000_pcie_enable_port(struct apple_t7000_pcie *pcie, int port)
+{
+	u32 shared_off = port * T7000_PCIE_PORT_STRIDE;
+	u32 ltssm_off = T7000_PCIE_LTSSM_BASE + port * T7000_PCIE_LTSSM_STRIDE;

-	return 0;
+	/* Traced sequence: AppleT7000PCIe::_enablePortHardware. */
+	t7000_pcie_rmw(pcie->shared, T7000_PCIE_LINK_ENABLE + shared_off, BIT(0), 0);
+	t7000_pcie_rmw(pcie->shared, T7000_PCIE_PERST_INTERNAL + shared_off, 0, BIT(0));
+	udelay(10);
+	t7000_pcie_rmw(pcie->shared, T7000_PCIE_UNKNOWN_10C + shared_off, BIT(0), 0);
+	t7000_pcie_rmw(pcie->shared, T7000_PCIE_REFCLK_EN + shared_off, 0, BIT(0));
+	udelay(100); /* t-refclk-to-perst, confirmed microseconds (real _IODelay call) */
+	t7000_pcie_rmw(pcie->shared, T7000_PCIE_LINK_ENABLE + shared_off, 0, BIT(0));
+	t7000_pcie_rmw(pcie->shared, T7000_PCIE_PERST_INTERNAL + shared_off, BIT(8), 0);
