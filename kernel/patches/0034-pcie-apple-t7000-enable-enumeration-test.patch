+static void t7000_pcie_enable_port_hardware(struct device *dev,
+					     void __iomem *shared, int port)
+{
+	u32 off = port * T7000_PCIE_PORT_STRIDE;
+	u32 ltssm_off = T7000_PCIE_LTSSM_BASE + port * T7000_PCIE_LTSSM_STRIDE;
+	u32 v;
 
-	return 0;
+	v = readl(shared + T7000_PCIE_LINK_ENABLE + off);
+	writel(v & ~BIT(0), shared + T7000_PCIE_LINK_ENABLE + off);
