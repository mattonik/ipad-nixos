 		return ret;
 
-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
+	t7000_pcie_log_port(dev, shared, T7000_PCIE_TEST_PORT, "before");
+
+	dev_info(dev, "t7000-pcie enable-enum-test: about to write the recovered enable sequence for port %d\n",
+		 T7000_PCIE_TEST_PORT);
+	t7000_pcie_enable_port_hardware(dev, shared, T7000_PCIE_TEST_PORT);
+	dev_info(dev, "t7000-pcie enable-enum-test: enable sequence write completed\n");
+
+	t7000_pcie_log_port(dev, shared, T7000_PCIE_TEST_PORT, "after");
+
+	dev_info(dev, "t7000-pcie enable-enum-test: init complete, handing back to generic ECAM core (PERST still asserted -- no reset-gpios node in this test)\n");
+
+	return 0;
 }
 
+static const struct pci_ecam_ops apple_t7000_pcie_ecam_ops = {
+	.init		= apple_t7000_pcie_init,
+	.pci_ops	= {
+		.map_bus	= pci_ecam_map_bus,
+		.read		= pci_generic_config_read,
+		.write		= pci_generic_config_write,
+	},
+};
+
+static int apple_t7000_pcie_probe(struct platform_device *pdev)
+{
+	struct pci_host_bridge *bridge;
+
+	dev_info(&pdev->dev, "t7000-pcie enable-enum-test: probe entry\n");
+
+	bridge = devm_pci_alloc_host_bridge(&pdev->dev, 0);
+	if (!bridge)
+		return -ENOMEM;
+
+	return pci_host_common_init(pdev, bridge, &apple_t7000_pcie_ecam_ops);
+}
