 /*
- * Compile-only groundwork for the Apple T7000-family PCIe host controller.
+ * Apple T7000-family PCIe -- remaining shared-window offsets read test.
  *
- * The real J81 ADT describes four ports, four port interrupts and twelve
- * register windows. Corellium's older H9P driver confirms the four-port
- * controller shape, but its register layout, SART and hard-coded PHY sequence
- * are not valid for T7000. The disabled device tree preserves J81's exact
- * resource ordering without naming the unresolved small-window roles. Keep
- * this driver inert until those roles, DART attachment and ADT-provided
- * tunables have been implemented.
+ * `0020`'s "bounded shared-window read test" hardware-verified clean, but
+ * it only re-checked one of the five shared-window registers the earlier
+ * `0018` drivers touched: the port-1 LTSSM register at `0x820 + 1*0x40 =
+ * 0x860`. It never independently isolated the other four -- port 1's
+ * `REFCLK_EN`, `PERST_INTERNAL`, the undocumented `0x10c`, and
+ * `LINK_ENABLE`, each with the `port * PORT_STRIDE` (`0x80`) offset the
+ * original `_enablePortHardware`-derived driver applied:
+ *
+ *   - REFCLK_EN      (0x100) + 0x80 = 0x180
+ *   - PERST_INTERNAL (0x108) + 0x80 = 0x188
+ *   - 0x10c                 + 0x80 = 0x18c
+ *   - LINK_ENABLE    (0x118) + 0x80 = 0x198
+ *
+ * The failed "read-only" `0018` attempt read all four of these (as part
+ * of logging port 1's full register snapshot) -- so unlike the shared
+ * LTSSM read `0020` isolated, these four specific offsets were never
+ * independently re-verified as safe on their own. This test reads them,
+ * still with DART disabled and no `iommu-map`, no ECAM, no PCI core, and
+ * no writes anywhere -- pure reads, closing the last passive gap before
+ * DART itself becomes the next thing to test in isolation. See
+ * docs/plans/2026-09-13-j81-wifi-pcie.md's "Next evidence gate" for the
+ * full reasoning and the four-step plan this is step 1 of.
  */

-#include <linux/errno.h>
+#include <linux/io.h>
 #include <linux/module.h>
-#include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/platform_device.h>

-#define APPLE_T7000_PCIE_NUM_PORTS	4
-#define APPLE_T7000_PCIE_NUM_REGIONS	12
+#define T7000_PCIE_REG_SHARED		9

-static int apple_t7000_pcie_validate_firmware(struct platform_device *pdev)
+#define T7000_PCIE_REFCLK_EN		0x180
+#define T7000_PCIE_PERST_INTERNAL	0x188
+#define T7000_PCIE_UNKNOWN_10C		0x18c
+#define T7000_PCIE_LINK_ENABLE		0x198
+
+static void t7000_pcie_read_offset(struct device *dev, void __iomem *shared,
+				    const char *name, u32 off)
 {
-	struct device *dev = &pdev->dev;
-	int count;
+	u32 val;

-	count = of_address_count(dev->of_node);
-	if (count != APPLE_T7000_PCIE_NUM_REGIONS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d register windows, found %d\n",
-				     APPLE_T7000_PCIE_NUM_REGIONS, count);
+	dev_info(dev, "t7000-pcie shared-remaining-test: about to read %s (offset 0x%x)\n",
+		 name, off);

-	count = platform_irq_count(pdev);
-	if (count < 0)
-		return count;
-	if (count != APPLE_T7000_PCIE_NUM_PORTS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d port interrupts, found %d\n",
-				     APPLE_T7000_PCIE_NUM_PORTS, count);
+	val = readl(shared + off);

-	return 0;
+	dev_info(dev, "t7000-pcie shared-remaining-test: %s = 0x%08x\n",
+		 name, val);
 }

 static int apple_t7000_pcie_probe(struct platform_device *pdev)
 {
+	struct device *dev = &pdev->dev;
+	struct resource res;
+	void __iomem *shared;
 	int ret;

-	ret = apple_t7000_pcie_validate_firmware(pdev);
+	dev_info(dev, "t7000-pcie shared-remaining-test: probe entry\n");
+
+	ret = of_address_to_resource(dev->of_node, T7000_PCIE_REG_SHARED, &res);
 	if (ret)
-		return ret;
+		return dev_err_probe(dev, ret, "missing register window %d\n",
+				      T7000_PCIE_REG_SHARED);

-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
+	dev_info(dev, "t7000-pcie shared-remaining-test: window %d at %pR\n",
+		 T7000_PCIE_REG_SHARED, &res);
+
+	shared = devm_ioremap_resource(dev, &res);
+	if (IS_ERR(shared))
+		return PTR_ERR(shared);
+
+	dev_info(dev, "t7000-pcie shared-remaining-test: mapped, starting bounded reads\n");
+
+	t7000_pcie_read_offset(dev, shared, "port1 refclk_en", T7000_PCIE_REFCLK_EN);
+	t7000_pcie_read_offset(dev, shared, "port1 perst_internal", T7000_PCIE_PERST_INTERNAL);
+	t7000_pcie_read_offset(dev, shared, "port1 unknown_10c", T7000_PCIE_UNKNOWN_10C);
+	t7000_pcie_read_offset(dev, shared, "port1 link_enable", T7000_PCIE_LINK_ENABLE);
+
+	dev_info(dev, "t7000-pcie shared-remaining-test: all reads completed\n");
+
+	return 0;
