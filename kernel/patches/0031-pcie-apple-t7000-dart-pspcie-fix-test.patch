diff --git a/drivers/pci/controller/pcie-apple-t7000.c b/drivers/pci/controller/pcie-apple-t7000.c
--- a/drivers/pci/controller/pcie-apple-t7000.c
+++ b/drivers/pci/controller/pcie-apple-t7000.c
@@ -1,59 +1,44 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Compile-only groundwork for the Apple T7000-family PCIe host controller.
+ * Apple T7000-family PCIe -- PMGR-only probe test, DART power-domains
+ * fix variant.
  *
- * The real J81 ADT describes four ports, four port interrupts and twelve
- * register windows. Corellium's older H9P driver confirms the four-port
- * controller shape, but its register layout, SART and hard-coded PHY sequence
- * are not valid for T7000. The disabled device tree preserves J81's exact
- * resource ordering without naming the unresolved small-window roles. Keep
- * this driver inert until those roles, DART attachment and ADT-provided
- * tunables have been implemented.
+ * The PCIe driver here is byte-for-byte the same as `0019`'s (the
+ * PMGR-only test that hardware-verified clean, 2026-09-23) and every
+ * later DART test's: probe() maps nothing and calls no PCI, ECAM or DART
+ * code at all. This patch's only changes are to the device tree:
+ * `dart_apcie1`'s `compatible` is restored to the real
+ * `"apple,t7000-dart", "apple,s5l8960x-dart"` strings (undoing the
+ * `0025`/`0027`/`0028` test-driver redirect, so the stock Linux
+ * `apple-dart` driver binds for real), and it now also carries
+ * `power-domains = <&ps_pcie>`.
+ *
+ * `0025` (real apple-dart driver, no power-domains of its own on
+ * dart_apcie1) hung on real hardware. `0028` (an isolated single write to
+ * DART+0x24, sharing that same missing reference) also hung, then booted
+ * clean once dart_apcie1 was given its own `power-domains = <&ps_pcie>`
+ * reference -- genpd power-up ordering is scoped per consumer device, and
+ * `pcie`'s own reference never guaranteed `ps_pcie` stayed powered for the
+ * DART's own, later probe. This test repeats `0025` itself with that one
+ * fix applied: the real driver, no `iommu-map`, `power-domains` added. See
+ * `research/t7000-pcie-hardware-findings.md`'s "Test A (`0028`) hardware
+ * result: clean" section for the full reasoning.
+ *
+ * No controller register writes, no PERST change, no PCI enumeration, no
+ * AUX/REF gate changes, no `iommu-map` consumer -- only the DART DT
+ * status/compatible/power-domains change.
  */
 
-#include <linux/errno.h>
 #include <linux/module.h>
-#include <linux/of.h>
-#include <linux/of_address.h>
 #include <linux/platform_device.h>
 
-#define APPLE_T7000_PCIE_NUM_PORTS	4
-#define APPLE_T7000_PCIE_NUM_REGIONS	12
-
-static int apple_t7000_pcie_validate_firmware(struct platform_device *pdev)
+static int apple_t7000_pcie_probe(struct platform_device *pdev)
 {
-	struct device *dev = &pdev->dev;
-	int count;
-
-	count = of_address_count(dev->of_node);
-	if (count != APPLE_T7000_PCIE_NUM_REGIONS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d register windows, found %d\n",
-				     APPLE_T7000_PCIE_NUM_REGIONS, count);
-
-	count = platform_irq_count(pdev);
-	if (count < 0)
-		return count;
-	if (count != APPLE_T7000_PCIE_NUM_PORTS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d port interrupts, found %d\n",
-				     APPLE_T7000_PCIE_NUM_PORTS, count);
-
+	dev_info(&pdev->dev,
+		 "t7000-pcie pmgr-only-test: probe reached (no MMIO, no PCI core; DART power-domains fix enabled separately)\n");
 	return 0;
 }
 
-static int apple_t7000_pcie_probe(struct platform_device *pdev)
-{
-	int ret;
-
-	ret = apple_t7000_pcie_validate_firmware(pdev);
-	if (ret)
-		return ret;
-
-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
-}
-
 static const struct of_device_id apple_t7000_pcie_of_match[] = {
 	{ .compatible = "apple,t7000-pcie" },
 	{ }
@@ -69,5 +54,5 @@
 };
 module_platform_driver(apple_t7000_pcie_driver);
 
-MODULE_DESCRIPTION("Compile-only Apple T7000 PCIe host bridge groundwork");
+MODULE_DESCRIPTION("Apple T7000 PCIe PMGR-only probe test, DART power-domains fix variant (no MMIO, no PCI core, no iommu-map)");
 MODULE_LICENSE("GPL");
diff --git a/arch/arm64/boot/dts/apple/t7001.dtsi b/arch/arm64/boot/dts/apple/t7001.dtsi
--- a/arch/arm64/boot/dts/apple/t7001.dtsi
+++ b/arch/arm64/boot/dts/apple/t7001.dtsi
@@ -342,10 +342,28 @@
 		dart_apcie1: iommu@602002000 {
+			/*
+			 * DART power-domains fix, real driver
+			 * (docs/plans/2026-09-13-j81-wifi-pcie.md,
+			 * research/t7000-pcie-hardware-findings.md): 0025
+			 * (real apple-dart driver, dart_apcie1 with no
+			 * power-domains of its own) hung on real hardware.
+			 * 0028 (an isolated single write, same missing
+			 * reference) also hung, then booted clean once
+			 * dart_apcie1 was given its own
+			 * power-domains = <&ps_pcie> reference -- genpd
+			 * power-up ordering is scoped per consumer device,
+			 * and pcie's own reference never guaranteed ps_pcie
+			 * stayed powered for the DART's own, later probe.
+			 * This test repeats 0025 itself (the real stock
+			 * apple-dart driver, compatible strings restored,
+			 * no iommu-map) with that one fix applied.
+			 */
 			compatible = "apple,t7000-dart", "apple,s5l8960x-dart";
 			reg = <0x6 0x02002000 0x0 0x00200000>;
 			#iommu-cells = <1>;
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 216 IRQ_TYPE_LEVEL_HIGH>;
-			status = "disabled";
+			power-domains = <&ps_pcie>;
+			status = "okay";
 		};
 
 		pcie: pcie@610000000 {
@@ -376,13 +394,18 @@
 				     <AIC_IRQ 218 IRQ_TYPE_LEVEL_HIGH>,
 				     <AIC_IRQ 221 IRQ_TYPE_LEVEL_HIGH>;
 
-			msi-controller;
-			msi-parent = <&pcie>;
-			msi-ranges = <&aic AIC_IRQ 224 IRQ_TYPE_EDGE_RISING 32>;
+			/*
+			 * DART power-domains fix test: this driver's probe()
+			 * still maps nothing and calls no PCI/ECAM/DART code
+			 * itself, so msi-controller/msi-parent/msi-ranges stay
+			 * omitted (no MSI domain implemented) and
+			 * iommu-map/iommu-map-mask stay omitted deliberately --
+			 * this test is the DART's own real probe/reset/IRQ
+			 * path alone, with no IOMMU consumer relationship
+			 * declared. A follow-up test would restore iommu-map,
+			 * only once this one is confirmed clean.
+			 */
 
-			iommu-map = <0x100 &dart_apcie1 0 1>;
-			iommu-map-mask = <0xff00>;
-
 			bus-range = <0 4>;
 			#address-cells = <3>;
 			#size-cells = <2>;
@@ -392,6 +415,6 @@
 				  0x7 0xc0000000 0x0 0x40000000>;
 
 			power-domains = <&ps_pcie>;
-			status = "disabled";
+			status = "okay";
 		};
 
