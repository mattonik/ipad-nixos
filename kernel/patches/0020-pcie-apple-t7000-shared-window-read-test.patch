 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Compile-only groundwork for the Apple T7000-family PCIe host controller.
+ * Apple T7000-family PCIe -- bounded shared-window MMIO read test.
  *
- * The real J81 ADT describes four ports, four port interrupts and twelve
- * register windows. Corellium's older H9P driver confirms the four-port
- * controller shape, but its register layout, SART and hard-coded PHY sequence
- * are not valid for T7000. The disabled device tree preserves J81's exact
- * resource ordering without naming the unresolved small-window roles. Keep
- * this driver inert until those roles, DART attachment and ADT-provided
- * tunables have been implemented.
+ * The PMGR-only test (`0019`) hardware-verified clean, 2026-09-23: booted
+ * exactly like the unmodified control payload, ruling out the DT
+ * `status = "okay"` flip and the automatic `power-domains = <&ps_pcie>`
+ * genpd power-up as causes of the earlier hang on their own. Both prior
+ * hanging attempts (`0018`) called `pci_host_common_init()`, which maps
+ * the ECAM config-space window and runs `pci_host_probe()` -- a full
+ * generic PCI bus scan issuing real config-space reads over MMIO. This
+ * test's driver never calls that either.
+ *
+ * Instead it maps only the shared root-complex register window (ADT reg
+ * index 9, the same window `0019` never even mapped), performs a single
+ * bounded `readl()` at board port 1's LTSSM-start offset, logs the raw
+ * value via `dev_info()`, and returns -- no PCI/ECAM code, no bus scan, no
+ * DART. If this hangs where `0019` didn't, the fault is in the shared
+ * window MMIO access itself (for example, this window may need clock or
+ * power sequencing beyond what `power-domains` alone provides before it is
+ * safely readable). If it boots clean like `0019` did, the fault is
+ * specifically in ECAM mapping or the generic PCI bus scan, not in
+ * touching controller MMIO at all.
+ *
+ * Register offset traced from AppleT7000PCIe::_enablePortHardware in the
+ * real J81 iOS 8.1 kernelcache -- not guessed. See
+ * docs/plans/2026-09-13-j81-wifi-pcie.md's "Enable-sequence checkpoint"
+ * section for the full evidence trail.
  */

-#include <linux/errno.h>
+#include <linux/io.h>
 #include <linux/module.h>
-#include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/platform_device.h>

-#define APPLE_T7000_PCIE_NUM_PORTS	4
-#define APPLE_T7000_PCIE_NUM_REGIONS	12
+#define T7000_PCIE_LTSSM_BASE		0x820
+#define T7000_PCIE_LTSSM_STRIDE	0x40
+#define T7000_PCIE_REG_SHARED		9
+#define T7000_PCIE_TEST_PORT		1

-static int apple_t7000_pcie_validate_firmware(struct platform_device *pdev)
+static int apple_t7000_pcie_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
-	int count;
+	struct resource res;
+	void __iomem *shared;
+	u32 ltssm_off;
+	u32 val;
+	int ret;

-	count = of_address_count(dev->of_node);
-	if (count != APPLE_T7000_PCIE_NUM_REGIONS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d register windows, found %d\n",
-				     APPLE_T7000_PCIE_NUM_REGIONS, count);
+	dev_info(dev, "t7000-pcie shared-read-test: probe entry\n");

-	count = platform_irq_count(pdev);
-	if (count < 0)
-		return count;
-	if (count != APPLE_T7000_PCIE_NUM_PORTS)
-		return dev_err_probe(dev, -EINVAL,
-				     "expected %d port interrupts, found %d\n",
-				     APPLE_T7000_PCIE_NUM_PORTS, count);
+	ret = of_address_to_resource(dev->of_node, T7000_PCIE_REG_SHARED, &res);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing register window %d\n",
+				      T7000_PCIE_REG_SHARED);

-	return 0;
-}
+	dev_info(dev, "t7000-pcie shared-read-test: window %d at %pR\n",
+		 T7000_PCIE_REG_SHARED, &res);

-static int apple_t7000_pcie_probe(struct platform_device *pdev)
-{
-	int ret;
+	shared = devm_ioremap_resource(dev, &res);
+	if (IS_ERR(shared))
+		return PTR_ERR(shared);

-	ret = apple_t7000_pcie_validate_firmware(pdev);
-	if (ret)
-		return ret;
+	dev_info(dev, "t7000-pcie shared-read-test: mapped, about to read LTSSM register\n");

-	return dev_err_probe(&pdev->dev, -EOPNOTSUPP,
-			     "link bring-up is not implemented\n");
+	ltssm_off = T7000_PCIE_LTSSM_BASE + T7000_PCIE_TEST_PORT * T7000_PCIE_LTSSM_STRIDE;
+	val = readl(shared + ltssm_off);
+
+	dev_info(dev, "t7000-pcie shared-read-test: port %d ltssm=0x%08x\n",
+		 T7000_PCIE_TEST_PORT, val);
+
+	return 0;
 }

