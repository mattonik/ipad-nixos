+        // framebuffer.
+        *(uint32_t *)(data + 16) = 50000000u;
+        *(uint32_t *)(data + 20) = (uint32_t)fb_words;
+        *(uint32_t *)(data + 24) = 15u;
+
+        cache_clean(marker_alloc, marker_alloc_size);
+        gLinuxMarkerStage = (void *)(((uint64_t)marker_alloc) - kCacheableView + 0x800000000);
+
+        // jump_to_image()'s tramp==0 "raw" path unconditionally skips its
+        // own SRAM-release trampoline, which its own code treats as
+        // mandatory (not optional) on chips without EL3. That release
+        // mechanism isn't A10-specific -- give it a real scratch physical
+        // page instead of 0 so it actually runs before we jump, rather
+        // than silently skipping a step three separate marker attempts
+        // may have been failing because of.
+        void *tramp_alloc = alloc_contig(0x4000);
+        if (!tramp_alloc) {
+            iprintf("T7001 tramp page allocation failed.\n");
+            return;
+        }
+        cache_clean(tramp_alloc, 0x4000);
+        gLinuxTrampStage = (void *)(((uint64_t)tramp_alloc) - kCacheableView + 0x800000000);
+    }
+
+    gLinuxPrepared = true;
 }
 
 void linux_boot()
 {
+    if (socnum == 0x7001)
+        return;
     memcpy(gEntryPoint, gLinuxStage, gLinuxStageSize);
     gTopOfKernelData = (uint64_t)gEntryPoint + gLinuxStageSize;
 }
