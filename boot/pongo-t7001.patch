+/*
+ * t7001_boot_marker.S — pre-kernel-entry framebuffer checkpoint for the T7001
+ * Linux handoff diagnostic. Not part of upstream pongoOS.
+ *
+ * jump_to_image()'s raw (tramp == 0) epilogue leaves, at entry to this stub:
+ *   x0 = args (the Linux DTB physical address)
+ *   x1 = x2 = x3 = 0
+ *   x30 = the physical address of this stub itself (already consumed by the
+ *         `ret` that got us here)
+ * None of those are load-bearing here: this build never continues to the
+ * kernel.
+ *
+ * v1 (2026-09-03): small one-shot white band, continued to kernel. Reported:
+ * an ~80px red/black band, wrong size/color/location — inconclusive.
+ *
+ * v2 (2026-09-03): one-shot full-screen black fill, spun forever after.
+ * Reported: a brief red tint, never a black fill, across 11.5s of video
+ * checked frame-by-frame — inconclusive, and suspiciously the same
+ * red/brief signature as v1 despite a totally different design.
+ *
+ * v3 (2026-09-03): infinite black/green strobe, ~0.3-1s per phase by a
+ * rough clock guess (500M busy-wait iterations). Reported: nothing at all
+ * across 12.4s of video sampled at 4fps -- until the observer separately
+ * reported "a very short flash right after the command was sent", too
+ * brief to land on any sampled frame. If that flash was this stub, the
+ * per-phase hold was far shorter than intended, i.e. the cycle-count guess
+ * was badly wrong (this core's actual clock/IPC at this boot stage is
+ * unknown), not that the stub failed to run.
+ *
+ * v4 (this version) stops rebuilding on a single guessed delay constant.
+ * Each color phase now re-fills the entire screen repeat_count times, with
+ * a delay between each re-fill, before switching color. This makes the
+ * total hold time per phase resistant to a bad per-iteration cycle guess
+ * (it scales with repeat_count regardless), and it re-asserts the color
+ * throughout the hold rather than writing it once -- so even if something
+ * else is periodically touching the framebuffer, our color keeps winning
+ * repeatedly rather than only once.
+ */
+.text
+.align 4
+.global _t7001_boot_marker
+_t7001_boot_marker:
+    adr  x9, marker_data
+    ldr  x10, [x9]            // x10 = framebuffer physical base (0 disables the strobe)
+    cbz  x10, 9f
+    ldr  w15, [x9, 20]        // w15 = word count (kept for the whole run)
+1:
+    ldr  w13, [x9, 24]        // w13 = repeat count for this phase
+7:
+    ldr  w11, [x9, 8]         // w11 = color A
+    mov  x2, x10
+    mov  w3, w15
+0:
+    str  w11, [x2], 4
+    subs w3, w3, 1
+    b.ne 0b
+    dsb  sy
+    ldr  w4, [x9, 16]         // w4 = delay iteration count (per re-fill)
+4:
+    subs w4, w4, 1
+    b.ne 4b
+    subs w13, w13, 1
+    b.ne 7b
+
+    ldr  w13, [x9, 24]
+8:
+    ldr  w11, [x9, 12]        // w11 = color B
+    mov  x2, x10
+    mov  w3, w15
+5:
+    str  w11, [x2], 4
+    subs w3, w3, 1
+    b.ne 5b
+    dsb  sy
+    ldr  w4, [x9, 16]
+6:
+    subs w4, w4, 1
+    b.ne 6b
+    subs w13, w13, 1
+    b.ne 8b
+    b    1b
+9:
+    b    9b                   // strobe disabled (fb base patched as 0): idle forever
+
+.align 3
+marker_data:
+    .quad 0   // +0:  framebuffer physical base address (patched; 0 disables the strobe)
+    .word 0   // +8:  color A, 32bpp a8b8g8r8 (patched)
+    .word 0   // +12: color B, 32bpp a8b8g8r8 (patched)
+    .word 0   // +16: delay-loop iteration count per re-fill (patched)
+    .word 0   // +20: word count -- framebuffer size in 32-bit words (patched)
+    .word 0   // +24: re-fill repeat count per color phase (patched)
+    .word 0   // +28: padding, unused
+.global _t7001_boot_marker_end
+_t7001_boot_marker_end:
