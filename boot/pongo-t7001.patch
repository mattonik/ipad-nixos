+void linux_diagnostics(void)
+{
+    if (!fdt_initialized) {
+        puts("Upload a DTB pack and run fdt before linux_diag.");
+        return;
+    }
+
+    void *dtree = linux_prepare_fdt();
+    void *stage = NULL;
+    void *diag_ramdisk = NULL;
+    uint64_t image_size = 0;
+    if (!dtree || !linux_stage_kernel(&stage, &image_size)) {
+        if (dtree) free(dtree);
+        return;
+    }
+
+    if (ramdisk_size != 0) {
+        diag_ramdisk = alloc_contig(ramdisk_size);
+        memcpy(diag_ramdisk, ramdisk_buf, ramdisk_size);
+    }
+    if (!linux_dtree_overlay(dtree, gLinuxCmdLine, diag_ramdisk, ramdisk_size)) {
+        free(dtree);
+        free_contig(stage, LINUX_IMAGE_CAPACITY + LINUX_DTREE_SIZE);
+        if (diag_ramdisk) free_contig(diag_ramdisk, ramdisk_size);
+        return;
+    }
+
+    iprintf("[t7001] soc=%x phys=%p size=%llx iBoot-entry=%p\n",
+            socnum, gBootArgs->physBase, gBootArgs->memSize, gEntryPoint);
+    iprintf("[t7001] image=%llu stage=%p/%p fdt=%p (%d bytes)\n",
+            image_size, stage, (void *)vatophys_static(stage), dtree,
+            fdt_totalsize(dtree));
+    if (diag_ramdisk)
+        iprintf("[t7001] initrd=%p/%p (%u bytes)\n", diag_ramdisk,
+                (void *)vatophys_static(diag_ramdisk), ramdisk_size);
+    iprintf("[t7001] candidate-entry=%p; diagnostic only, no jump attempted.\n",
+            (void *)0x800080000ULL);
+
+    free(dtree);
+    free_contig(stage, LINUX_IMAGE_CAPACITY + LINUX_DTREE_SIZE);
+    if (diag_ramdisk) free_contig(diag_ramdisk, ramdisk_size);
 }
 
