+static void *linux_prepare_fdt(void)
+{
+    void *selected = malloc(LINUX_DTREE_SIZE);
+    void *expanded = malloc(LINUX_DTREE_SIZE);
+
+    if (!selected || !expanded) {
+        puts("Cannot allocate Linux DTB work buffers.");
+        if (selected) free(selected);
+        if (expanded) free(expanded);
+        return NULL;
+    }
+    if (!fdt_select_dtree(fdt, selected) ||
+        fdt_open_into(selected, expanded, LINUX_DTREE_SIZE)) {
+        puts("Cannot prepare Linux DTB.");
+        free(selected);
+        free(expanded);
+        return NULL;
+    }
+    free(selected);
+    return expanded;
+}
+
+static bool linux_stage_kernel(void **allocation, void **stage, uint64_t *image_size)
+{
+    if (loader_xfer_recv_count == 0) {
+        puts("No Linux kernel was uploaded.");
+        return false;
+    }
+
+    *allocation = alloc_contig(LINUX_STAGE_ALLOCATION);
+    *stage = (void *)(((uint64_t)*allocation + LINUX_IMAGE_ALIGNMENT - 1) &
+                      ~(LINUX_IMAGE_ALIGNMENT - 1));
+    size_t output_size = LINUX_IMAGE_CAPACITY;
+    int result = unlzma_decompress(*stage, &output_size, loader_xfer_recv_data,
+                                   loader_xfer_recv_count);
+    if (result != SZ_OK) {
+        if (loader_xfer_recv_count < 24) {
+            iprintf("LZMA decode failed (%d) and payload is too short for an Image header.\n", result);
+            free_contig(*allocation, LINUX_STAGE_ALLOCATION);
+            return false;
+        }
+        *image_size = *(uint64_t *)(loader_xfer_recv_data + 16);
+        if (*image_size > LINUX_IMAGE_CAPACITY || *image_size > loader_xfer_recv_count) {
+            iprintf("LZMA decode failed (%d); raw Image size is invalid: %llu.\n", result, *image_size);
+            free_contig(*allocation, LINUX_STAGE_ALLOCATION);
+            return false;
+        }
+        memcpy(*stage, loader_xfer_recv_data, *image_size);
+    } else {
+        if (output_size < 24) {
+            puts("Decoded Linux Image is too short for its header.");
+            free_contig(*allocation, LINUX_STAGE_ALLOCATION);
+            return false;
+        }
+        *image_size = *(uint64_t *)(*stage + 16);
+        if (*image_size < output_size || *image_size > LINUX_IMAGE_CAPACITY) {
+            iprintf("Decoded Linux Image layout size is invalid: %llu.\n", *image_size);
+            free_contig(*allocation, LINUX_STAGE_ALLOCATION);
+            return false;
+        }
+    }
+    return true;
+}
