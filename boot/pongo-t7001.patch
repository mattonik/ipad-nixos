+static void *linux_prepare_fdt(void)
+{
+    void *selected = malloc(LINUX_DTREE_SIZE);
+    void *expanded = malloc(LINUX_DTREE_SIZE);
+
+    if (!selected || !expanded) {
+        puts("Cannot allocate Linux DTB work buffers.");
+        if (selected) free(selected);
+        if (expanded) free(expanded);
+        return NULL;
+    }
+    if (!fdt_select_dtree(fdt, selected) ||
+        fdt_open_into(selected, expanded, LINUX_DTREE_SIZE)) {
+        puts("Cannot prepare Linux DTB.");
+        free(selected);
+        free(expanded);
+        return NULL;
+    }
+    free(selected);
+    return expanded;
+}
