+/*
+ * t7001_entry_marker.S — observability stub placed at the real T7001 Linux
+ * entry point, ahead of the actual kernel Image. Not part of upstream
+ * pongoOS.
+ *
+ * v1 (2026-09-04, Step 6): painted the framebuffer, held briefly, then
+ * branched into the kernel Image that linux_boot() had already copied to
+ * its destination *before* this stub ever ran. Confirmed staged correctly
+ * (no allocation/staging errors, correct addresses printed), but never
+ * observed on screen across a 20s/60fps recording -- a clean negative,
+ * unlike every ambiguous earlier sighting.
+ *
+ * v2 (this version) tests a specific hypothesis for that silence: the
+ * ~41 MiB kernel copy that used to happen in linux_boot(), in the
+ * low-level post-teardown context (interrupts disabled, possibly
+ * uncached), before any jump at all -- if that copy is far slower than it
+ * looks (uncached DRAM access can be far slower than cached), it could
+ * trip a hardware watchdog reset before execution ever reaches this stub
+ * or the kernel. This version paints the marker and holds *first* --
+ * proving reachability on its own, independent of anything after -- then
+ * does the big kernel copy itself, *after* jumping here, so a watchdog
+ * during that copy can no longer prevent the marker from ever being seen.
+ *
+ * jump_to_image()'s epilogue (via stage3_exit_to_el1_image, itself invoked
+ * through the shared exit_to_el1_image() call) leaves, at entry here:
+ *   x0 = the Linux DTB physical address — MUST be preserved unchanged
+ *   x1 = x2 = x3 = 0 — MUST remain 0 for the real kernel entry
+ *   x30 = this stub's own physical address — already consumed by the
+ *         `ret` that got us here, unused from here on
+ */
+.text
+.align 4
+.global _t7001_entry_marker
+_t7001_entry_marker:
+    adr  x14, marker_data
+    // --- paint the framebuffer: proves reachability on its own ---
+    ldr  x10, [x14]            // x10 = framebuffer physical base (0 disables the marker)
+    cbz  x10, 1f
+    ldr  w11, [x14, 8]         // w11 = marker pixel value
+    ldr  w12, [x14, 12]        // w12 = word count (framebuffer size in 32-bit words)
+0:
+    str  w11, [x10], 4
+    subs w12, w12, 1
+    b.ne 0b
+    dsb  sy
+1:
+    // --- hold briefly, so a camera has a chance to catch it ---
+    ldr  w13, [x14, 36]        // w13 = delay iteration count
+2:
+    subs w13, w13, 1
+    b.ne 2b
+    // --- now do the real kernel's copy, after the marker already ran ---
+    ldr  x16, [x14, 16]        // x16 = kernel destination physical address
+    ldr  x15, [x14, 24]        // x15 = kernel source physical address (gLinuxStage)
+    ldr  w17, [x14, 32]        // w17 = kernel copy length, in 32-bit words
+    cbz  w17, 4f
+3:
+    ldr  w18, [x15], 4
+    str  w18, [x16], 4
+    subs w17, w17, 1
+    b.ne 3b
+4:
+    // Freshly-written instructions: the icache may not see them yet.
+    // Mirrors jump_to_image.S's own barrier sequence before its jump.
+    dsb  sy
+    ic   iallu
+    dsb  sy
+    isb
+    ldr  x9, [x14, 16]         // x9 = kernel destination == the real kernel entry
+    mov  x1, 0
+    mov  x2, 0
+    mov  x3, 0
+    br   x9
+
+.align 3
+marker_data:
+    .quad 0   // +0:  framebuffer physical base address (patched; 0 disables the marker)
+    .word 0   // +8:  marker pixel value, 32bpp a8b8g8r8 (patched)
+    .word 0   // +12: word count for the framebuffer fill (patched)
+    .quad 0   // +16: kernel destination physical address == jump target (patched)
+    .quad 0   // +24: kernel source physical address, i.e. gLinuxStage (patched)
+    .word 0   // +32: kernel copy length in 32-bit words (patched)
+    .word 0   // +36: delay iteration count (patched)
+.global _t7001_entry_marker_end
+_t7001_entry_marker_end:
