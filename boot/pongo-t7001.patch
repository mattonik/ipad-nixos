+static int reserve_memmap_region_cb(void *a, dt_node_t *node, int depth, const char *key, void *val, uint32_t len)
+{
+    reserve_memmap_cb_t *arg = a;
+    if (len != 16 || !strcmp(key, "name") || !strcmp(key, "SEPFW"))
+        return 0;
+    uint64_t *region = val;
+    uint64_t addr = region[0];
+    uint64_t size = region[1];
+    if (size == 0)
+        return 0;
+    char fdt_nodename[64];
+    siprintf(fdt_nodename, "memory@%llx-%s", addr, key);
+    int node1 = fdt_add_subnode(arg->dtree, arg->resv_node, fdt_nodename);
+    if (node1 < 0) {
