+    void *dtree = linux_prepare_fdt();
+    void *stage_allocation = NULL;
+    void *stage = NULL;
+    void *diag_dtree = NULL;
+    void *diag_ramdisk = NULL;
+    uint64_t image_size = 0;
+    if (!dtree || !linux_stage_kernel(&stage_allocation, &stage, &image_size)) {
+        if (dtree) free(dtree);
+        return;
+    }
+
+    if (ramdisk_size != 0) {
+        diag_ramdisk = alloc_contig(ramdisk_size);
+        memcpy(diag_ramdisk, ramdisk_buf, ramdisk_size);
+    }
+    if (!linux_dtree_overlay(dtree, gLinuxCmdLine, diag_ramdisk, ramdisk_size)) {
+        free(dtree);
+        free_contig(stage_allocation, LINUX_STAGE_ALLOCATION);
+        if (diag_ramdisk) free_contig(diag_ramdisk, ramdisk_size);
+        return;
+    }
+
+    int dtree_size = fdt_totalsize(dtree);
+    if (dtree_size <= 0 || dtree_size > LINUX_DTREE_SIZE || dtree_size > 2 * 1024 * 1024) {
+        iprintf("Invalid Linux DTB size: %d.\n", dtree_size);
+        free(dtree);
+        free_contig(stage_allocation, LINUX_STAGE_ALLOCATION);
+        if (diag_ramdisk) free_contig(diag_ramdisk, ramdisk_size);
+        return;
+    }
+    diag_dtree = alloc_contig(dtree_size);
+    memcpy(diag_dtree, dtree, dtree_size);
+
+    uint64_t stage_phys = vatophys_static(stage);
+    uint64_t text_offset = *(uint64_t *)(stage + 8);
+    uint64_t image_base = stage_phys - text_offset;
+    if (image_base & (LINUX_IMAGE_ALIGNMENT - 1)) {
+        iprintf("Linux Image base %p is not 2 MiB aligned.\n", (void *)image_base);
+        free(dtree);
+        free_contig(stage_allocation, LINUX_STAGE_ALLOCATION);
+        free_contig(diag_dtree, dtree_size);
+        if (diag_ramdisk) free_contig(diag_ramdisk, ramdisk_size);
+        return;
+    }
+
+    iprintf("[t7001] soc=%x phys=%p size=%llx iBoot-entry=%p\n",
+            socnum, gBootArgs->physBase, gBootArgs->memSize, gEntryPoint);
+    iprintf("[t7001] image=%llu stage=%p/%p text-offset=%llx base=%p\n",
+            image_size, stage, (void *)stage_phys, text_offset, (void *)image_base);
+    iprintf("[t7001] fdt=%p/%p (%d bytes), x0=%p x1=x2=x3=0 EL%d\n",
+            diag_dtree, (void *)vatophys_static(diag_dtree), dtree_size,
+            (void *)vatophys_static(diag_dtree), get_el());
+    if (diag_ramdisk)
+        iprintf("[t7001] initrd=%p/%p (%u bytes)\n", diag_ramdisk,
+                (void *)vatophys_static(diag_ramdisk), ramdisk_size);
+    iprintf("[t7001] candidate-entry=%p; diagnostic only, no jump attempted.\n",
+            (void *)stage_phys);
+
+    free(dtree);
+    free_contig(stage_allocation, LINUX_STAGE_ALLOCATION);
+    free_contig(diag_dtree, dtree_size);
+    if (diag_ramdisk) free_contig(diag_ramdisk, ramdisk_size);
