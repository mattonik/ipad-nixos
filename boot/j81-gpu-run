#!/bin/sh
# Runs under /tmp/gpu-watchdog-supervisor --j81-gpu <module-sha256> <boot-id>. TEST ONLY.
# Loads /tmp/j81-gpu.ko and drives its steps one at a time; every step is announced (stage=before-..., host answers READ) and
# reported (stage=after-..., host answers FEED n) so the 20 s watchdog is fed only after each completed step.
set -u
[ "$#" -eq 2 ] || exit 2
hash=$1 boot_id=$2
case "$boot_id" in ????????-????-????-????-????????????) ;; *) exit 2 ;; esac
case "$hash" in *[!0-9a-f]*|'') exit 2 ;; esac
[ "${#hash}" -eq 64 ] || exit 2
dev=/sys/devices/j81-gpu
[ "$(cat /proc/sys/kernel/random/boot_id)" = "$boot_id" ] || exit 1
[ "$(uname -r)" = 7.3.0-rc1 ] || exit 1
[ "$(uname -m)" = aarch64 ] || exit 1
[ "$(sha256sum /tmp/j81-gpu.ko | cut -d ' ' -f 1)" = "$hash" ] || exit 1
[ "$(sha256sum /sys/kernel/notes | cut -d ' ' -f 1)" = a2dda2719fef771c109dd2ca2baee4bdc31ec13902aed677f4ea7d9aad7b7f4a ] || exit 1
[ "$(cat /proc/device-tree/model)" = 'Apple iPad Air 2 (Wi-Fi)' ] || exit 1
tr '\000' '\n' </proc/device-tree/compatible | grep -qx apple,j81 || exit 1
grep -q '^rootfs / rootfs ' /proc/mounts || exit 1
if grep -q '^/dev/' /proc/mounts; then exit 1; fi
[ ! -e /sys/module/j81_gpu ] || exit 1
mkdir /tmp/j81-gpu.once || exit 1
skip=0 skip4=0
[ -e /tmp/j81-gpu.skip-pll1 ] && skip=1
[ -e /tmp/j81-gpu.skip-pll4 ] && skip4=1
/sbin/insmod /tmp/j81-gpu.ko "skip_pll1=$skip" "skip_pll4=$skip4" || exit 1
for step in precheck pmgr activate batch; do
    printf 'stage=before-%s width=32\n' "$step"
    IFS= read -r reply
    [ "$reply" = READ ] || exit 1
    if ! echo "$step" >"$dev/step"; then
        printf 'stage=failed-%s %s\nstage=finished rc=1\n' "$step" "$(cat $dev/status)"
        exit 1
    fi
    printf 'stage=after-%s %s\n' "$step" "$(cat $dev/status)"
done
# Optional META slave-port survey: addresses (0x + 8 hex digits, one per line) staged in /tmp/j81-gpu.metas.
if [ -f /tmp/j81-gpu.metas ]; then
    exec 3<&0
    while IFS= read -r addr; do
        case "$addr" in 0x????????) ;; *) continue ;; esac
        printf 'stage=before-meta-%s width=32\n' "$addr"
        IFS= read -r reply <&3
        [ "$reply" = READ ] || exit 1
        echo "$addr" >"$dev/meta" || { printf 'stage=failed-meta-%s\nstage=finished rc=1\n' "$addr"; exit 1; }
        printf 'stage=after-meta-%s %s\n' "$addr" "$(cat $dev/meta)"
    done </tmp/j81-gpu.metas
fi
# Optional read-only survey: offsets (hex, one per line) staged by the host in /tmp/j81-gpu.peeks.
if [ -f /tmp/j81-gpu.peeks ]; then
    exec 3<&0
    while IFS= read -r off; do
        case "$off" in 0x????) ;; *) continue ;; esac
        printf 'stage=before-peek-%s width=32\n' "$off"
        IFS= read -r reply <&3
        [ "$reply" = READ ] || exit 1
        echo "$off" >"$dev/peek" || { printf 'stage=finished rc=1\n'; exit 1; }
        printf 'stage=after-peek-%s %s\n' "$off" "$(cat $dev/peek)"
    done </tmp/j81-gpu.peeks
fi
# Optional guarded write steps (w1, w2a, f1, f2): names staged in /tmp/j81-gpu.writes. Each is its own stage; a failure stops the run.
if [ -f /tmp/j81-gpu.writes ]; then
    exec 3<&0
    while IFS= read -r wstep; do
        case "$wstep" in pa|hn|w1|w2a|h0|h1|h2|h3|h4|h5|h6|h7|h8|h9|h10|h11|h7b|h7c|h7d|h7e|h7f|h7g|h7s|h7m|h7r|h7z|h7y|h7q|h7p|h3at|h3p|h3pb|h6x|h6m|h6md|h7x|h8n|h12|h12s|h7k|h7l|h7a|h7f1|h7f2|f3alloc|f3upload|f3load|f3poll|f3bif|f3sum|f3chg|f3pc|f3timer|f3meta|f3metaA|f3metaB|f3metaC|f3metaD|z0|z1|z2|z3|g0|g1|g2|g3|g4|f1a|f1|f2) ;; *) continue ;; esac
        printf 'stage=before-write-%s width=32\n' "$wstep"
        IFS= read -r reply <&3
        [ "$reply" = READ ] || exit 1
        if [ "$wstep" = f3upload ]; then
            test -f /tmp/j81-f3a.blob && cat /tmp/j81-f3a.blob >"$dev/f3_img"
        else
            echo "$wstep" >"$dev/step"
        fi
        if [ $? -ne 0 ]; then
            printf 'stage=failed-write-%s %s\nstage=finished rc=1\n' "$wstep" "$(cat $dev/status)"
            exit 1
        fi
        printf 'stage=after-write-%s %s\n' "$wstep" "$(cat $dev/status)"
    done </tmp/j81-gpu.writes
fi
printf 'stage=finished rc=0\n'
